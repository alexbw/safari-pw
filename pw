def _jxa(script, timeout=30):
    """Execute a JXA script via osascript. Returns stdout."""
    try:
        result = subprocess.run(
            ["osascript", "-l", "JavaScript"],
            input=script, capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        raise PwError(f"JXA script timed out after {timeout}s")
    if result.returncode != 0:
        stderr = result.stderr.strip()
        if "not allowed to send keystrokes" in stderr.lower():
            raise PwError(
                "Accessibility permission required for type/press.\n"
                "System Settings > Privacy & Security > Accessibility > enable your terminal"
            )
        if "apple events" in stderr.lower():
            raise PwError(
                "Safari setup required:\n"
                "1. Safari > Settings > Advanced > 'Show features for web developers'\n"
                "2. Safari > Settings > Developer > 'Allow JavaScript from Apple Events'"
            )
        if "(-600)" in stderr or "not running" in stderr.lower():
            raise PwError("Safari is not running. Use: pw launch")
        raise PwError(f"JXA error: {stderr}")
    return result.stdout.strip()


def _osascript(script, timeout=5):
    """Best-effort AppleScript execution via osascript -e. Used by the
    window-management helpers (bury, close) where any failure mode is
    handled by the next pw command's boot-time sweep — there's nothing
    actionable to raise to the caller."""
    try:
        return subprocess.run(
            ["osascript", "-e", script],
            capture_output=True, timeout=timeout,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None


def _safe_json_write(path, obj):
    """Locked-down JSON write at `path` with mode 0600 and O_NOFOLLOW so
    a pre-created symlink at the path can't redirect the write. No-ops
    silently on OSError (e.g., refusing to follow a symlink)."""
    _ensure_state_dir()
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags, 0o600)
    except OSError:
        return
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f)


def _js_escape(s):
    """Escape a string for safe embedding in JavaScript source."""
    return json.dumps(s)


def _build_tab_finder_jxa(session_id, hint_win=0, hint_tab=0):
    """Return JXA code that sets __pw_win and __pw_tab by scanning for session marker.

    Fast path: check the hinted window/tab indices first.
    Slow path: scan all windows/tabs for the session marker.
    Fallback: use hinted indices if no session_id or scan fails.

    The returned code assumes `var safari = Application("Safari");` is already declared.
    It declares __pw_win (window ref) and __pw_tab (tab ref).
    """
    if not session_id:
        # No session tracking — use stored indices directly
        return f'var __pw_win = safari.windows[{hint_win}]; var __pw_tab = __pw_win.tabs[{hint_tab}];'

    escaped_sid = json.dumps(session_id)
    return f'''
    var __pw_win = null, __pw_tab = null;
    // Fast path: check hinted indices first
    try {{
        var __hint_w = safari.windows[{hint_win}];
        var __hint_t = __hint_w.tabs[{hint_tab}];
        var __hint_sid = safari.doJavaScript("window.__pw_session_id || ''", {{in: __hint_t}});
        if (__hint_sid === {escaped_sid}) {{
            __pw_win = __hint_w;
            __pw_tab = __hint_t;
        }}
    }} catch(e) {{}}
    // Slow path: scan all windows/tabs
    if (!__pw_tab) {{
        for (var __fw = 0; __fw < safari.windows.length; __fw++) {{
            for (var __ft = 0; __ft < safari.windows[__fw].tabs.length; __ft++) {{
                try {{
                    var __fsid = safari.doJavaScript("window.__pw_session_id || ''", {{in: safari.windows[__fw].tabs[__ft]}});
                    if (__fsid === {escaped_sid}) {{
                        __pw_win = safari.windows[__fw];
                        __pw_tab = safari.windows[__fw].tabs[__ft];
                        break;
                    }}
                }} catch(e) {{}}
            }}
            if (__pw_tab) break;
        }}
    }}
    // No managed tab found. Refuse to fall back to a stored index or to
    // the user's frontmost tab — operating on a tab pw didn't create is
    // exactly the hijacking we promise never to do. Throw so the Python
    // layer can catch and create a fresh managed tab + retry.
    if (!__pw_tab) {{
        throw new Error("__PW_TAB_GONE__: no managed pw tab for session " + {escaped_sid});
    }}
    '''


def _translate_selector(selector):
    """Translate text= selectors to JS querySelector expressions."""
    if selector.startswith("text="):
        text = selector[5:]
        escaped = _js_escape(text)
        # Find the innermost element whose textContent matches — excludes ancestors
        return (
            f'(function(){{'
            f'var t={escaped};'
            f'var all=Array.from(document.querySelectorAll("*")).filter(function(el){{return el.textContent.trim()===t}});'
            f'return all.filter(function(el){{return !Array.from(el.children).some(function(c){{return c.textContent.trim()===t}})}})[0];'
            f'}})()'
        )
    return f"document.querySelector({_js_escape(selector)})"


class _SafariElement:
    """Wrapper for Safari element interaction via JXA."""

    def __init__(self, selector_js, tab_idx, window_idx=0, session_id=None):
        self._sel = selector_js
        self._tab = tab_idx
        self._win = window_idx
        self._session_id = session_id

    def _exec(self, js):
        escaped = json.dumps(js)
        finder = _build_tab_finder_jxa(self._session_id, self._win, self._tab)
        script = f'''
        var safari = Application("Safari");
        {finder}
        safari.doJavaScript({escaped}, {{in: __pw_tab}});
        '''
        return _jxa(script)

    def inner_text(self):
        result = self._exec(f'(function(){{ var el={self._sel}; return el ? el.innerText : null; }})()')
        if not result or result == "null":
            raise PwError("Element has no text")
        return result

    def inner_html(self):
        result = self._exec(f'(function(){{ var el={self._sel}; return el ? el.innerHTML.substring(0,100000) : null; }})()')
        if not result or result == "null":
            raise PwError("Element has no HTML")
        return result


class _SafariKeyboard:
    """Safari keyboard interaction.

    Default path runs JS in the pw tab — fully backgrounded, Safari stays put.
    Set PW_KEYSTROKE=1 to force OS-level keystrokes via System Events; that
    path activates Safari (it has to, since keystrokes route to the frontmost
    app) and is only needed for sites that ignore synthetic KeyboardEvents.
    """

    def __init__(self, page=None):
        self._page = page

    def _use_keystroke(self):
        return self._page is None or os.environ.get("PW_KEYSTROKE") == "1"

    def type(self, text):
        if self._use_keystroke():
            self._type_keystroke(text)
            return
        # JS path: per-character keydown/keypress/insertText/keyup so
        # type-as-you-search sites (autocomplete, Cmd-K palettes, etc.)
        # see real-looking key events. Synthetic events have isTrusted=false;
        # if the target site enforces isTrusted, set PW_KEYSTROKE=1.
        escaped = _js_escape(text)
        js = f'''(function(){{
            var el = document.activeElement;
            if (!el || el === document.body) {{
                throw new Error("no focused element — call .click() or .focus() first, or set PW_KEYSTROKE=1");
            }}
            var text = {escaped};
            var tag = (el.tagName || "").toUpperCase();
            if (!(el.isContentEditable || tag === "INPUT" || tag === "TEXTAREA")) {{
                throw new Error("focused element is not editable: " + tag);
            }}
            el.focus();
            var nativeSetter = null;
            if (tag === "INPUT" || tag === "TEXTAREA") {{
                var proto = tag === "INPUT" ? HTMLInputElement.prototype : HTMLTextAreaElement.prototype;
                var desc = Object.getOwnPropertyDescriptor(proto, "value");
                nativeSetter = desc && desc.set;
            }}
            for (var i = 0; i < text.length; i++) {{
                var ch = text[i];
                var code = ch.charCodeAt(0);
                var keyOpts = {{key: ch, code: "Key" + ch.toUpperCase(),
                                keyCode: code, which: code,
                                bubbles: true, cancelable: true}};
                var dn = new KeyboardEvent("keydown", keyOpts);
                var canceled = !el.dispatchEvent(dn);
                el.dispatchEvent(new KeyboardEvent("keypress", keyOpts));
                if (!canceled) {{
                    var ok = document.execCommand("insertText", false, ch);
                    if (!ok && nativeSetter) {{
                        nativeSetter.call(el, (el.value || "") + ch);
                        el.dispatchEvent(new Event("input", {{bubbles: true}}));
                    }}
                }}
                el.dispatchEvent(new KeyboardEvent("keyup", keyOpts));
            }}
            // Final change event so blur-style validators fire
            el.dispatchEvent(new Event("change", {{bubbles: true}}));
            return "ok";
        }})()'''
        self._page._do_js(js)

    def _type_keystroke(self, text):
        _require_foreground_opt_in("PW_KEYSTROKE")
        escaped = _js_escape(text)
        _jxa(f'''
        var safari = Application("Safari");
        safari.activate();
        Application("System Events").keystroke({escaped});
        "ok";
        ''')

    def press(self, key):
        if self._use_keystroke():
            self._press_keystroke(key)
            return
        # JS path: dispatch synthetic KeyboardEvent + handle special keys
        # (Enter→form submit, Tab→focus next, Backspace/Delete→execCommand).
        js = f'''(function(){{
            var key = {_js_escape(key)};
            var el = document.activeElement || document.body;
            var keyMap = {{
                Enter: {{key: "Enter", code: "Enter", keyCode: 13}},
                Tab: {{key: "Tab", code: "Tab", keyCode: 9}},
                Escape: {{key: "Escape", code: "Escape", keyCode: 27}},
                Backspace: {{key: "Backspace", code: "Backspace", keyCode: 8}},
                Delete: {{key: "Delete", code: "Delete", keyCode: 46}},
                ArrowUp: {{key: "ArrowUp", code: "ArrowUp", keyCode: 38}},
                ArrowDown: {{key: "ArrowDown", code: "ArrowDown", keyCode: 40}},
                ArrowLeft: {{key: "ArrowLeft", code: "ArrowLeft", keyCode: 37}},
                ArrowRight: {{key: "ArrowRight", code: "ArrowRight", keyCode: 39}},
                Space: {{key: " ", code: "Space", keyCode: 32}},
                Home: {{key: "Home", code: "Home", keyCode: 36}},
                End: {{key: "End", code: "End", keyCode: 35}},
                PageUp: {{key: "PageUp", code: "PageUp", keyCode: 33}},
                PageDown: {{key: "PageDown", code: "PageDown", keyCode: 34}}
            }};
            var info = keyMap[key] || {{key: key, code: key, keyCode: 0}};
            ["keydown", "keypress", "keyup"].forEach(function(type) {{
                if (type === "keypress" && key.length > 1 && key !== "Enter" && key !== "Space") return;
                try {{
                    var ev = new KeyboardEvent(type, {{
                        key: info.key, code: info.code, keyCode: info.keyCode,
                        which: info.keyCode, bubbles: true, cancelable: true
                    }});
                    el.dispatchEvent(ev);
                }} catch (e) {{}}
            }});
            if (key === "Enter") {{
                // Synthetic Enter doesn't reliably submit forms in modern
                // frameworks, so call requestSubmit / submit directly.
                if (el.form) {{
                    if (typeof el.form.requestSubmit === "function") {{
                        try {{ el.form.requestSubmit(); }} catch(e) {{ el.form.submit(); }}
                    }} else {{
                        el.form.submit();
                    }}
                }}
            }} else if (key === "Tab") {{
                var focusables = Array.prototype.slice.call(document.querySelectorAll(
                    'input, button, select, textarea, a[href], [tabindex]:not([tabindex="-1"])'
                )).filter(function(e) {{ return !e.disabled && e.offsetParent !== null; }});
                var idx = focusables.indexOf(el);
                if (idx >= 0 && idx < focusables.length - 1) {{
                    focusables[idx + 1].focus();
                }} else if (focusables.length > 0) {{
                    focusables[0].focus();
                }}
            }} else if (key === "Backspace") {{
                if (el.isContentEditable || el.tagName === "INPUT" || el.tagName === "TEXTAREA") {{
                    document.execCommand("delete", false);
                }}
            }} else if (key === "Delete") {{
                if (el.isContentEditable || el.tagName === "INPUT" || el.tagName === "TEXTAREA") {{
                    document.execCommand("forwardDelete", false);
                }}
            }}
            return "ok";
        }})()'''
        self._page._do_js(js)

    def _press_keystroke(self, key):
        _require_foreground_opt_in("PW_KEYSTROKE")
        if key in MAC_KEY_CODES:
