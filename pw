#!/usr/bin/env python3
"""
pw — Safari-only browser automation CLI for Claude Code.

Controls Safari via JXA (JavaScript for Automation) in the BACKGROUND --
Safari does not need to be in the foreground. Supports macOS Keychain
password autofill and Touch ID. For Chromium automation, use the
Playwright MCP plugin instead.

Usage:
    pw launch                         Start Safari
    pw nav URL                        Navigate to URL, print title
    pw click SELECTOR                 Click an element (CSS or text=...)
    pw fill SELECTOR TEXT             Fill an input field
    pw type TEXT                      Type text into the focused element
    pw press KEY                      Press a key (Enter, Tab, Escape, etc.)
    pw select SEL VALUE               Select an option from a dropdown
    pw screenshot [PATH]              Screenshot to PATH (default /tmp/pw-screenshot.png)
    pw snap                           Fast page state: title + URL + text (one call)
    pw text [SELECTOR]                Get visible text (full page or selector)
    pw html [SELECTOR]                Get innerHTML (full page or selector)
    pw eval JS                        Evaluate JavaScript, print result
    pw title                          Print page title
    pw url                            Print current URL
    pw links [SELECTOR]               List links (text + href) on the page or in selector
    pw wait SELECTOR                  Wait for selector to appear (up to 10s)
    pw tabs                           List open tabs
    pw tab INDEX                      Switch to tab by index
    pw back                           Navigate back
    pw close                          Close the browser
    pw status                         Check if browser is running
    pw doctor                         Check Safari setup (permissions, settings)
    pw batch "CMD1" "CMD2" ...        Run multiple commands in one connection (faster)
    pw react-click SELECTOR           Click via React fiber (background-safe, for MUI/React)
    pw react-set SEL PROP VALUE       Set React component value via handler (e.g. onChange)

Output flags (nav, click, back auto-include page text by default):
    pw nav URL                        Navigate + auto-print page text
    pw nav URL --links [SEL]          Navigate + print links instead
    pw nav URL --html [SEL]           Navigate + print HTML instead
    pw nav URL --quiet                Navigate only, no page text
    pw click SEL                      Click + auto-print page text
    pw click SEL --links              Click + print links instead
    pw click SEL --html [SEL2]        Click + print HTML instead
    pw click SEL --quiet              Click only, no page text
    pw back                           Back + auto-print page text
    pw back --quiet                   Back only, no page text

Named sessions: Use --name SESSION or set PW_SESSION env var for multi-agent use.
    Each session tracks its own tab independently. Example:
        pw nav https://site-a.com --name agent1
        pw nav https://site-b.com --name agent2
        pw click "#btn" --name agent1     # targets site-a tab
        pw fill "#input" "text" --name agent2  # targets site-b tab

Safari setup (one-time):
    1. Safari > Settings > Advanced > check "Show features for web developers"
    2. Safari > Settings > Developer > check "Allow JavaScript from Apple Events"
    3. First run: approve "Terminal wants to control Safari" dialog

Note: react-click and react-set find React fiber internals on DOM elements
and invoke component handlers directly, bypassing the DOM event system.
This works for MUI, React, and similar frameworks entirely in the background.

Background mode: type/press/screenshot run fully in the background by default
(Safari stays where it is). type/press use synthetic KeyboardEvents
(isTrusted=false). If a site ignores those (rare — most do not), set
PW_KEYSTROKE=1 to force OS-level keystrokes via System Events; that path
activates Safari and requires Accessibility permission.
"""

import json
import os
import subprocess
import sys
import time
import urllib.parse
from json import dumps as _json_escape

SCREENSHOT_DEFAULT = "/tmp/pw-screenshot.png"

# --- Safari state ---
# State lives under the user's Application Support dir (mode 0700),
# not /tmp, so other local users can't read session URLs / IDs and can't
# pre-create symlinks at predictable paths to clobber unrelated files.
STATE_DIR = os.path.join(
    os.path.expanduser("~"), "Library", "Application Support", "safari-pw"
)
SAFARI_TAB_FILE = os.path.join(STATE_DIR, "default.json")

# --- Session management ---
_session_name = None  # set by --name flag
_session_counter = 0  # monotonic counter for unique session IDs


def _ensure_state_dir():
    """Create the per-user state dir with mode 0700 if missing."""
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        # If the dir already existed with looser perms, tighten it.
        try:
            os.chmod(STATE_DIR, 0o700)
        except OSError:
            pass
    except OSError:
        pass


_SAFE_SESSION_RE = None  # lazy-compiled in _safe_session_name


def _safe_session_name(name):
    """Validate a --name / PW_SESSION value. Reject anything that could escape
    the state dir or collide via path traversal. Allowed: [A-Za-z0-9._-], 1-64 chars."""
    global _SAFE_SESSION_RE
    if _SAFE_SESSION_RE is None:
        import re
        _SAFE_SESSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
    if not _SAFE_SESSION_RE.match(name) or name in (".", "..") or name.startswith("."):
        raise PwError(
            f"Invalid session name {name!r}: must match [A-Za-z0-9._-]{{1,64}} "
            "and cannot start with '.' or be '.'/'..'."
        )
    return name

