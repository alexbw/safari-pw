    "  return {"
    "    target: el, currentTarget: el,"
    "    preventDefault: function(){}, stopPropagation: function(){},"
    "    nativeEvent: new MouseEvent(type || 'click'),"
    "    type: type || 'click',"
    "    bubbles: true, cancelable: true"
    "  };"
    "}"
)


# ============================================================
# AngularJS helper JS (used by ng-set, ng-click)
# ============================================================
#
# AngularJS 1.x ties two-way binding to its own $digest cycle. Setting
# `el.value = X` and dispatching an `input` event usually works, but
# breaks when the form is wrapped in custom directives, when validators
# inspect $touched/$dirty state set elsewhere, or when ng-click is bound
# to a button that also carries aria-disabled (which Angular checks via
# its own event listener chain — a raw `el.click()` skips that listener).
#
# These helpers go through Angular's own API: `angular.element(el)` for
# the jqLite wrapper, `.controller('ngModel').$setViewValue()` for value
# updates, `.triggerHandler('click')` for clicks. Updates run inside
# `$scope.$apply()` so watchers fire and the digest cycle commits.

ANGULAR_HELPER_JS = (
    "function __pw_ngEl(el) {"
    "  if (typeof angular === 'undefined' || !angular.element) return null;"
    "  return angular.element(el);"
    "}"
    "function __pw_ngScope(el) {"
    "  var $el = __pw_ngEl(el);"
    "  if (!$el) return null;"
    "  return $el.scope() || $el.isolateScope() || null;"
    "}"
    "function __pw_ngApply(scope, fn) {"
    "  if (scope && scope.$root && scope.$root.$$phase) { fn(); return; }"
    "  if (scope && typeof scope.$apply === 'function') { scope.$apply(fn); return; }"
    "  fn();"
    "}"
)


class PwError(Exception):
    """Raised for expected errors that should produce a clean error message."""
    pass


def _require_foreground_opt_in(triggered_by):
    """Refuse to foreground Safari unless the caller explicitly opted in via
    PW_ALLOW_FOREGROUND=1. pw runs in the background by design — the user may
    be actively using Safari, and stealing focus disrupts their work."""
    if os.environ.get("PW_ALLOW_FOREGROUND") == "1":
        return
    raise PwError(
        f"{triggered_by} requires foregrounding Safari, which is disabled "
        "by default to avoid disrupting your browsing. Set "
        "PW_ALLOW_FOREGROUND=1 to allow it (only safe when no human is "
        "using Safari)."
    )


def _wrap_multi_statement_js(js):
    """Wrap multi-statement JS in an IIFE so Safari JXA returns the last value.

    Safari's doJavaScript only returns the value of the last expression.
    Multi-statement code (var, try/catch, assignments) returns undefined/null.
    This wraps such code in (function(){ ... })() with a return on the last statement.
    """
    js = js.strip()
    # Already an IIFE — leave alone
    if js.startswith("(function"):
        return js
    # Single expression (no semicolons outside strings) — leave alone
    # Simple heuristic: if no ';' at all, it's a single expression
    if ";" not in js and "\n" not in js:
        return js
    # Multi-statement: split on last semicolon/newline, add return before last expr
    # Strip trailing semicolons/whitespace
    while js.endswith(";") or js.endswith("\n"):
        js = js.rstrip(";\n").rstrip()
    # Find last statement boundary
    lines = [l.strip() for l in js.replace(";", ";\n").split("\n") if l.strip()]
    if not lines:
        return js
    last = lines[-1]
    # Don't add return if last line already has return, or is a control structure
    if not last.startswith("return ") and not last.startswith("if") and not last.startswith("for") and not last.startswith("while") and not last.startswith("try") and not last.startswith("}"):
        lines[-1] = "return " + last
    body = "; ".join(lines)
    return f"(function(){{ {body} }})()"


