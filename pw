# --- Safari state ---
# State lives under the user's Application Support dir (mode 0700),
# not /tmp, so other local users can't read session URLs / IDs and can't
# pre-create symlinks at predictable paths to clobber unrelated files.
STATE_DIR = os.path.join(
    os.path.expanduser("~"), "Library", "Application Support", "safari-pw"
)
SAFARI_TAB_FILE = os.path.join(STATE_DIR, "default.json")
# Native helper that posts real Quartz mouse events (isTrusted=true), used
# by `pw trusted-click` and `pw download` to defeat WebKit's user-gesture
# check on click handlers that trigger downloads, file pickers, etc.
# Build by running `helpers/safari-trusted-click/build.sh` (or invoking
# swiftc directly on the .swift source there).
def _pw_script_dir():
    # __file__ isn't defined under the test loader (importlib SourceFileLoader
    # gives the module no __file__ attr). Fall back to sys.argv[0] in that case.
    try:
        return os.path.dirname(os.path.abspath(__file__))
    except NameError:
        return os.path.dirname(os.path.abspath(sys.argv[0]))


TRUSTED_CLICK_BIN = os.path.join(
    _pw_script_dir(), "helpers", "safari-trusted-click", "safari-trusted-click",
)
# Registry of Safari window ids that pw has created and owns. Used to
# distinguish "windows pw can safely bury / push tabs into" from
# windows that just happen to contain an orphan __pw_managed marker (e.g.
# a user's Safari window where a buggy older pw left a marker before the
# user navigated it away). We only reuse / hide windows whose id is in
# this registry.
PW_WINDOW_REGISTRY = os.path.join(STATE_DIR, "windows.json")

# --- Session management ---
_session_name = None  # set by --name flag
_session_counter = 0  # monotonic counter for unique session IDs


def _ensure_state_dir():
    """Create the per-user state dir with mode 0700 if missing."""
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        # If the dir already existed with looser perms, tighten it.
        try:
            os.chmod(STATE_DIR, 0o700)
        except OSError:
            pass
    except OSError:
        pass


_SAFE_SESSION_RE = None  # lazy-compiled in _safe_session_name


def _safe_session_name(name):
    """Validate a --name / PW_SESSION value. Reject anything that could escape
    the state dir or collide via path traversal. Allowed: [A-Za-z0-9._-], 1-64 chars."""
    global _SAFE_SESSION_RE
    if _SAFE_SESSION_RE is None:
        import re
        _SAFE_SESSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
    if not _SAFE_SESSION_RE.match(name) or name in (".", "..") or name.startswith("."):
        raise PwError(
            f"Invalid session name {name!r}: must match [A-Za-z0-9._-]{{1,64}} "
            "and cannot start with '.' or be '.'/'..'."
        )
    return name

