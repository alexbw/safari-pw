def connect_and_run(fn):
    """Connect to Safari and execute fn(browser, ctx, page)."""
    return _safari_connect_and_run(fn)


# --- Output flag helpers ---


def _print_page_text(page, selector=None):
    """Print page text (used by --text flag and cmd_text)."""
    if selector:
        el = page.query_selector(selector)
        if not el:
            raise PwError(f"Selector not found: {selector}")
        print(el.inner_text())
    else:
        text = page.inner_text("body")
        lines = [l.strip() for l in text.split("\n") if l.strip()]
        print("\n".join(lines[:200]))
        if len(lines) > 200:
            print(f"\n... ({len(lines) - 200} more lines, use a selector to narrow)")


def _print_page_links(page, selector=None):
    """Print page links (used by --links flag and cmd_links)."""
    if selector:
        safe_sel = _json_escape(selector + " a")
        container = f"document.querySelectorAll({safe_sel})"
    else:
        container = 'document.querySelectorAll("a")'
    links = page.evaluate(f"""
        Array.from({container}).map(a => ({{
            text: a.innerText.trim().substring(0, 80),
            href: a.href
        }})).filter(l => l.href && l.href !== 'javascript:void(0)')
    """)
    if not links:
        links = []
    for i, link in enumerate(links[:100]):
        text = link["text"] or "(no text)"
        print(f"[{i}] {text} → {link['href']}")
    if len(links) > 100:
        print(f"\n... ({len(links) - 100} more links)")


def _print_page_html(page, selector=None):
    """Print page HTML (used by --html flag and cmd_html)."""
    if selector:
        el = page.query_selector(selector)
        if not el:
            raise PwError(f"Selector not found: {selector}")
        print(el.inner_html())
    else:
        html = page.content()
        if len(html) > 50000:
            print(html[:50000])
            print(f"\n... (truncated, {len(html)} total chars)")
        else:
            print(html)


def _handle_output_flag(page, output_flag, output_selector=None):
    """Handle --text/--links/--html output flags after an action."""
    if not output_flag:
        return
    print("---")
    if output_flag == "text":
        _print_page_text(page, output_selector)
    elif output_flag == "links":
        _print_page_links(page, output_selector)
    elif output_flag == "html":
        _print_page_html(page, output_selector)


def _parse_output_flags(args):
    """Extract --text/--links/--html/--quiet from args. Returns (clean_args, flag, flag_selector).

    --quiet suppresses the default auto-text output (returns flag=None).
    """
    flag = None
    flag_selector = None
    explicit = False  # True if user explicitly set a flag
    quiet = False
    clean = []
    i = 0
    while i < len(args):
        if args[i] == "--quiet":
            quiet = True
            i += 1
            continue
        if args[i] in ("--text", "--links", "--html"):
            flag = args[i][2:]  # strip --
            explicit = True
            # Check if next arg is a selector (not another flag or option)
            if i + 1 < len(args) and not args[i + 1].startswith("--"):
                flag_selector = args[i + 1]
                i += 2
                continue
            i += 1
            continue
        clean.append(args[i])
        i += 1
    if quiet and not explicit:
        flag = False  # False = explicitly no output (distinct from None = not specified)
    return clean, flag, flag_selector


