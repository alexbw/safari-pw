}


def _jxa(script, timeout=30):
    """Execute a JXA script via osascript. Returns stdout."""
    try:
        result = subprocess.run(
            ["osascript", "-l", "JavaScript"],
            input=script, capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        raise PwError(f"JXA script timed out after {timeout}s")
    if result.returncode != 0:
        stderr = result.stderr.strip()
        if "not allowed to send keystrokes" in stderr.lower():
            raise PwError(
                "Accessibility permission required for type/press.\n"
                "System Settings > Privacy & Security > Accessibility > enable your terminal"
            )
        if "apple events" in stderr.lower():
            raise PwError(
                "Safari setup required:\n"
                "1. Safari > Settings > Advanced > 'Show features for web developers'\n"
                "2. Safari > Settings > Developer > 'Allow JavaScript from Apple Events'"
            )
        if "(-600)" in stderr or "not running" in stderr.lower():
            raise PwError("Safari is not running. Use: pw launch")
        raise PwError(f"JXA error: {stderr}")
    return result.stdout.strip()


def _js_escape(s):
    """Escape a string for safe embedding in JavaScript source."""
    return json.dumps(s)


def _build_tab_finder_jxa(session_id, hint_win=0, hint_tab=0):
    """Return JXA code that sets __pw_win and __pw_tab by scanning for session marker.

    Fast path: check the hinted window/tab indices first.
    Slow path: scan all windows/tabs for the session marker.
    Fallback: use hinted indices if no session_id or scan fails.

    The returned code assumes `var safari = Application("Safari");` is already declared.
    It declares __pw_win (window ref) and __pw_tab (tab ref).
    """
    if not session_id:
        # No session tracking — use stored indices directly
        return f'var __pw_win = safari.windows[{hint_win}]; var __pw_tab = __pw_win.tabs[{hint_tab}];'

    escaped_sid = json.dumps(session_id)
    return f'''
    var __pw_win = null, __pw_tab = null;
    // Fast path: check hinted indices first
    try {{
        var __hint_w = safari.windows[{hint_win}];
        var __hint_t = __hint_w.tabs[{hint_tab}];
        var __hint_sid = safari.doJavaScript("window.__pw_session_id || ''", {{in: __hint_t}});
        if (__hint_sid === {escaped_sid}) {{
            __pw_win = __hint_w;
            __pw_tab = __hint_t;
        }}
    }} catch(e) {{}}
    // Slow path: scan all windows/tabs
    if (!__pw_tab) {{
        for (var __fw = 0; __fw < safari.windows.length; __fw++) {{
            for (var __ft = 0; __ft < safari.windows[__fw].tabs.length; __ft++) {{
                try {{
                    var __fsid = safari.doJavaScript("window.__pw_session_id || ''", {{in: safari.windows[__fw].tabs[__ft]}});
                    if (__fsid === {escaped_sid}) {{
                        __pw_win = safari.windows[__fw];
                        __pw_tab = safari.windows[__fw].tabs[__ft];
                        break;
                    }}
                }} catch(e) {{}}
            }}
            if (__pw_tab) break;
        }}
    }}
    // Fallback: use hinted indices
    if (!__pw_tab) {{
        __pw_win = safari.windows[{hint_win}];
        __pw_tab = __pw_win.tabs[{hint_tab}];
    }}
    '''


def _translate_selector(selector):
    """Translate text= selectors to JS querySelector expressions."""
    if selector.startswith("text="):
        text = selector[5:]
        escaped = _js_escape(text)
        # Find the innermost element whose textContent matches — excludes ancestors
        return (
            f'(function(){{'
            f'var t={escaped};'
            f'var all=Array.from(document.querySelectorAll("*")).filter(function(el){{return el.textContent.trim()===t}});'
            f'return all.filter(function(el){{return !Array.from(el.children).some(function(c){{return c.textContent.trim()===t}})}})[0];'
            f'}})()'
        )
    return f"document.querySelector({_js_escape(selector)})"


class _SafariElement:
    """Wrapper for Safari element interaction via JXA."""

    def __init__(self, selector_js, tab_idx, window_idx=0, session_id=None):
        self._sel = selector_js
        self._tab = tab_idx
        self._win = window_idx
        self._session_id = session_id

    def _exec(self, js):
        escaped = json.dumps(js)
        finder = _build_tab_finder_jxa(self._session_id, self._win, self._tab)
        script = f'''
        var safari = Application("Safari");
        {finder}
        safari.doJavaScript({escaped}, {{in: __pw_tab}});
        '''
        return _jxa(script)

    def inner_text(self):
        result = self._exec(f'(function(){{ var el={self._sel}; return el ? el.innerText : null; }})()')
        if not result or result == "null":
            raise PwError("Element has no text")
        return result

    def inner_html(self):
        result = self._exec(f'(function(){{ var el={self._sel}; return el ? el.innerHTML.substring(0,100000) : null; }})()')
        if not result or result == "null":
            raise PwError("Element has no HTML")
        return result


class _SafariKeyboard:
    """Safari keyboard interaction.

    Default path runs JS in the pw tab — fully backgrounded, Safari stays put.
    Set PW_KEYSTROKE=1 to force OS-level keystrokes via System Events; that
    path activates Safari (it has to, since keystrokes route to the frontmost
    app) and is only needed for sites that ignore synthetic KeyboardEvents.
    """

    def __init__(self, page=None):
        self._page = page

    def _use_keystroke(self):
        return self._page is None or os.environ.get("PW_KEYSTROKE") == "1"

    def type(self, text):
        if self._use_keystroke():
            self._type_keystroke(text)
            return
        # JS path: per-character keydown/keypress/insertText/keyup so
        # type-as-you-search sites (autocomplete, Cmd-K palettes, etc.)
        # see real-looking key events. Synthetic events have isTrusted=false;
        # if the target site enforces isTrusted, set PW_KEYSTROKE=1.
        escaped = _js_escape(text)
        js = f'''(function(){{
            var el = document.activeElement;
            if (!el || el === document.body) {{
                throw new Error("no focused element — call .click() or .focus() first, or set PW_KEYSTROKE=1");
            }}
            var text = {escaped};
            var tag = (el.tagName || "").toUpperCase();
            if (!(el.isContentEditable || tag === "INPUT" || tag === "TEXTAREA")) {{
                throw new Error("focused element is not editable: " + tag);
            }}
            el.focus();
            var nativeSetter = null;
            if (tag === "INPUT" || tag === "TEXTAREA") {{
                var proto = tag === "INPUT" ? HTMLInputElement.prototype : HTMLTextAreaElement.prototype;
                var desc = Object.getOwnPropertyDescriptor(proto, "value");
                nativeSetter = desc && desc.set;
            }}
            for (var i = 0; i < text.length; i++) {{
                var ch = text[i];
                var code = ch.charCodeAt(0);
                var keyOpts = {{key: ch, code: "Key" + ch.toUpperCase(),
                                keyCode: code, which: code,
                                bubbles: true, cancelable: true}};
                var dn = new KeyboardEvent("keydown", keyOpts);
                var canceled = !el.dispatchEvent(dn);
                el.dispatchEvent(new KeyboardEvent("keypress", keyOpts));
                if (!canceled) {{
                    var ok = document.execCommand("insertText", false, ch);
                    if (!ok && nativeSetter) {{
                        nativeSetter.call(el, (el.value || "") + ch);
                        el.dispatchEvent(new Event("input", {{bubbles: true}}));
                    }}
                }}
                el.dispatchEvent(new KeyboardEvent("keyup", keyOpts));
            }}
            // Final change event so blur-style validators fire
            el.dispatchEvent(new Event("change", {{bubbles: true}}));
            return "ok";
        }})()'''
        self._page._do_js(js)

    def _type_keystroke(self, text):
        escaped = _js_escape(text)
        _jxa(f'''
        var safari = Application("Safari");
        safari.activate();
        Application("System Events").keystroke({escaped});
        "ok";
        ''')

    def press(self, key):
        if self._use_keystroke():
            self._press_keystroke(key)
            return
        # JS path: dispatch synthetic KeyboardEvent + handle special keys
        # (Enter→form submit, Tab→focus next, Backspace/Delete→execCommand).
        js = f'''(function(){{
            var key = {_js_escape(key)};
            var el = document.activeElement || document.body;
            var keyMap = {{
                Enter: {{key: "Enter", code: "Enter", keyCode: 13}},
                Tab: {{key: "Tab", code: "Tab", keyCode: 9}},
                Escape: {{key: "Escape", code: "Escape", keyCode: 27}},
                Backspace: {{key: "Backspace", code: "Backspace", keyCode: 8}},
                Delete: {{key: "Delete", code: "Delete", keyCode: 46}},
                ArrowUp: {{key: "ArrowUp", code: "ArrowUp", keyCode: 38}},
                ArrowDown: {{key: "ArrowDown", code: "ArrowDown", keyCode: 40}},
                ArrowLeft: {{key: "ArrowLeft", code: "ArrowLeft", keyCode: 37}},
                ArrowRight: {{key: "ArrowRight", code: "ArrowRight", keyCode: 39}},
                Space: {{key: " ", code: "Space", keyCode: 32}},
                Home: {{key: "Home", code: "Home", keyCode: 36}},
                End: {{key: "End", code: "End", keyCode: 35}},
                PageUp: {{key: "PageUp", code: "PageUp", keyCode: 33}},
                PageDown: {{key: "PageDown", code: "PageDown", keyCode: 34}}
            }};
            var info = keyMap[key] || {{key: key, code: key, keyCode: 0}};
            ["keydown", "keypress", "keyup"].forEach(function(type) {{
                if (type === "keypress" && key.length > 1 && key !== "Enter" && key !== "Space") return;
                try {{
                    var ev = new KeyboardEvent(type, {{
                        key: info.key, code: info.code, keyCode: info.keyCode,
                        which: info.keyCode, bubbles: true, cancelable: true
                    }});
                    el.dispatchEvent(ev);
                }} catch (e) {{}}
            }});
            if (key === "Enter") {{
                // Synthetic Enter doesn't reliably submit forms in modern
                // frameworks, so call requestSubmit / submit directly.
                if (el.form) {{
                    if (typeof el.form.requestSubmit === "function") {{
                        try {{ el.form.requestSubmit(); }} catch(e) {{ el.form.submit(); }}
                    }} else {{
                        el.form.submit();
                    }}
                }}
            }} else if (key === "Tab") {{
                var focusables = Array.prototype.slice.call(document.querySelectorAll(
                    'input, button, select, textarea, a[href], [tabindex]:not([tabindex="-1"])'
                )).filter(function(e) {{ return !e.disabled && e.offsetParent !== null; }});
                var idx = focusables.indexOf(el);
                if (idx >= 0 && idx < focusables.length - 1) {{
                    focusables[idx + 1].focus();
                }} else if (focusables.length > 0) {{
                    focusables[0].focus();
                }}
            }} else if (key === "Backspace") {{
                if (el.isContentEditable || el.tagName === "INPUT" || el.tagName === "TEXTAREA") {{
                    document.execCommand("delete", false);
                }}
            }} else if (key === "Delete") {{
                if (el.isContentEditable || el.tagName === "INPUT" || el.tagName === "TEXTAREA") {{
                    document.execCommand("forwardDelete", false);
                }}
            }}
            return "ok";
        }})()'''
        self._page._do_js(js)

    def _press_keystroke(self, key):
        if key in MAC_KEY_CODES:
            _jxa(f'''
            var safari = Application("Safari");
            safari.activate();
            Application("System Events").keyCode({MAC_KEY_CODES[key]});
            "ok";
            ''')
        else:
            _jxa(f'''
            var safari = Application("Safari");
            safari.activate();
            Application("System Events").keystroke({_js_escape(key)});
            "ok";
            ''')


class _SafariTabProxy:
    """Represents a Safari tab."""

    def __init__(self, idx, tab_title, tab_url, window_idx=0):
        self._idx = idx
        self._title = tab_title
        self._url = tab_url
        self._win = window_idx

    def title(self):
        return self._title

    @property
    def url(self):
        return self._url

    def bring_to_front(self):
        _jxa(f'''
        var safari = Application("Safari");
        safari.windows[{self._win}].currentTab = safari.windows[{self._win}].tabs[{self._idx}];
        "ok";
        ''')


class _SafariCtx:
    """Safari browser context — fetches tabs lazily via .pages."""

    def __init__(self, window_idx=0):
        self._win = window_idx

    @property
    def pages(self):
        raw = _jxa(f'''
        var safari = Application("Safari");
        var win = safari.windows[{self._win}];
        var tabs = [];
        for (var i = 0; i < win.tabs.length; i++) {{
            tabs.push({{title: win.tabs[i].name(), url: win.tabs[i].url()}});
        }}
        JSON.stringify(tabs);
        ''')
        tab_data = json.loads(raw) if raw else []
        return [_SafariTabProxy(i, t["title"], t["url"], window_idx=self._win) for i, t in enumerate(tab_data)]


class SafariPage:
    """Safari page interface via JXA/osascript."""

    def __init__(self, tab_idx=0, session_id=None, window_idx=0):
        self._tab = tab_idx
        self._win = window_idx
        self.keyboard = _SafariKeyboard(page=self)
        self._last_nav = {}  # cached title/url from goto()
        self._session_id = session_id or _new_session_id()

    def _find_tab_jxa(self):
        """Return JXA code that finds this session's tab by marker.

        Sets __pw_win (window ref) and __pw_tab (tab ref).
        Assumes `var safari = Application("Safari");` is already declared.
        """
        return _build_tab_finder_jxa(self._session_id, self._win, self._tab)

    def _do_js(self, js, timeout=30):
        """Execute JS in the current Safari tab via doJavaScript.

        Wraps the JS in a try/catch to detect errors that Safari's
        doJavaScript would otherwise silently swallow.
        """
        # Wrap JS to catch errors and return them as a detectable signal
        wrapped = f'''(function(){{
            try {{ return {js}; }}
            catch(e) {{ return "__PW_ERROR__:" + e.message; }}
        }})()'''
        escaped = json.dumps(wrapped)
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        safari.doJavaScript({escaped}, {{in: __pw_tab}});
        '''
        result = _jxa(script, timeout=timeout)
        if result and result.startswith("__PW_ERROR__:"):
            raise PwError(result[len("__PW_ERROR__:"):])
        return result

    def goto(self, url, wait_until=None, timeout=30000):
        escaped_url = _js_escape(url)
        timeout_s = max(timeout // 1000, 5)
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var oldUrl = tab.url();
        tab.url = {escaped_url};
        var deadline = Date.now() + {timeout};
        var sameUrlNav = (oldUrl === {escaped_url} || oldUrl === {escaped_url} + "/" ||
                          oldUrl + "/" === {escaped_url});

        if (sameUrlNav) {{
            // Same-URL reload: just wait for readyState after a brief pause
            delay(0.3);
            while (Date.now() < deadline) {{
                try {{
                    var rs = safari.doJavaScript("document.readyState", {{in: tab}});
                    if (rs === "complete") break;
                }} catch(e) {{}}
                delay(0.1);
            }}
        }} else {{
            // Cross-URL nav: wait for JS context URL to change, then readyState
            while (Date.now() < deadline) {{
                try {{
                    var jsUrl = safari.doJavaScript("location.href", {{in: tab}});
                    if (jsUrl && jsUrl !== oldUrl) {{
                        var rs = safari.doJavaScript("document.readyState", {{in: tab}});
                        if (rs === "complete" || rs === "interactive") break;
                    }}
                }} catch(e) {{
                    // doJavaScript may throw during page transitions — that's fine
                }}
                delay(0.1);
            }}
        }}

        // Get title from JS context (tab.name() can be stale during navigation)
        var finalTitle = "";
        try {{ finalTitle = safari.doJavaScript("document.title", {{in: tab}}); }} catch(e) {{}}
        if (!finalTitle) finalTitle = tab.name();
        JSON.stringify({{title: finalTitle, url: tab.url()}});
        '''
        raw = _jxa(script, timeout=timeout_s + 5)
        # Cache result to avoid extra osascript calls
        try:
            self._last_nav = json.loads(raw) if raw else {}
        except (json.JSONDecodeError, TypeError):
            self._last_nav = {}
        # Inject session marker and managed flag for tab tracking
        try:
            self._do_js(f'window.__pw_session_id = {_js_escape(self._session_id)}; window.__pw_managed = true;')
        except PwError:
            pass
        # Persist tab state
        _write_tab_state({
            "session_id": self._session_id,
            "url": self._last_nav.get("url", ""),
            "tab_index": self._tab,
            "window_index": self._win,
        })

    def title(self):
        if self._last_nav:
            return self._last_nav.get("title", "")
        finder = self._find_tab_jxa()
        return _jxa(f'var safari = Application("Safari"); {finder} __pw_tab.name();') or ""

    @property
    def url(self):
        if self._last_nav:
            return self._last_nav.get("url", "")
        finder = self._find_tab_jxa()
        return _jxa(f'var safari = Application("Safari"); {finder} __pw_tab.url();') or ""


    def _auto_wait(self, sel_js, timeout=5000):
        """Poll for element existence up to timeout. Returns True if found.

        Polls at 1s intervals (not faster) to avoid overwhelming Safari's
        Apple Events handler, which can cause macOS to kill Safari for
        excessive CPU usage.
        """
        check_js = json.dumps(f'({sel_js}) !== null ? "found" : "nope"')
        finder = self._find_tab_jxa()
        # First check immediately
        try:
            result = _jxa(f'''
            var safari = Application("Safari");
            {finder}
            safari.doJavaScript({check_js}, {{in: __pw_tab}});
            ''', timeout=5)
            if result == "found":
                return True
        except PwError:
            pass
        # Then poll at 1s intervals — gentle on Safari's event handler
        deadline = time.time() + timeout / 1000
        while time.time() < deadline:
            time.sleep(1.0)
            try:
                result = _jxa(f'''
                var safari = Application("Safari");
                {finder}
                safari.doJavaScript({check_js}, {{in: __pw_tab}});
                ''', timeout=5)
                if result == "found":
                    return True
            except PwError:
                pass
        return False

    def _click_js(self, sel_js, selector):
        """Generate JS that clicks with React fiber support.

        Strategy (all background-safe via doJavaScript):
          A: el.click() -- native DOM method, works for many components.
          B: React 18 internal dispatch -- find the click listener registered on
             the React root container and invoke it via __dispatchEvent or by
             walking the fiber tree to find the actual app-level handler.
          C: React fiber onClick/onMouseDown prop invocation.
          D: Full synthetic pointer/mouse event sequence as last resort.
        """
        return (
            "(function(){"
            + REACT_FIBER_JS +

            # Utility: find app-level onClick by walking up past MUI wrapper components
            "function __pw_findAppHandler(fiber) {"
            "  var current = fiber;"
            "  var handlers = [];"
            "  while (current) {"
            "    if (current.memoizedProps && current.memoizedProps.onClick) {"
            "      handlers.push({handler: current.memoizedProps.onClick, type: current.type,"
            "        name: typeof current.type === 'function' ? current.type.name || current.type.displayName : String(current.type)});"
            "    }"
            "    current = current.return;"
            "  }"
            # Return the highest-level handler (closest to app root, furthest from DOM)
            # Skip the first one if it's on 'button' (MUI ButtonBase ripple handler)
            "  if (handlers.length > 1 && handlers[0].name === 'button') return handlers[handlers.length - 1];"
            "  return handlers.length > 0 ? handlers[handlers.length - 1] : null;"
            "}"

            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + _js_escape(selector) + ");"
            "el.scrollIntoView({block: 'center'});"

            # Strategy A: el.click()
            "try { el.click(); } catch(e) {}"

            # Strategy B: Find app-level handler via fiber tree (skip MUI wrappers)
            "var fiber = __pw_getReactFiber(el);"
            "if (fiber) {"
            "  var appHandler = __pw_findAppHandler(fiber);"
            "  if (appHandler && appHandler.handler) {"
            "    try {"
            "      appHandler.handler(__pw_makeSyntheticEvent(el, 'click'));"
            "      return 'clicked (react app handler: ' + appHandler.name + ')';"
            "    } catch(e) {}"
            "  }"

            # Strategy C: Direct fiber prop handlers (onMouseDown + onClick)
            "  var onMD = __pw_findHandler(fiber, 'onMouseDown');"
            "  if (onMD) { try { onMD(__pw_makeSyntheticEvent(el, 'mousedown')); } catch(e) {} }"
            "  var onClick = __pw_findHandler(fiber, 'onClick');"
            "  if (onClick) {"
            "    try { onClick(__pw_makeSyntheticEvent(el, 'click')); } catch(e) {}"
            "    return 'clicked (react fiber onClick)';"
            "  }"
            "}"

            # Strategy D: Synthetic event sequence
            "var rect = el.getBoundingClientRect();"
            "var x = rect.left + rect.width / 2;"
            "var y = rect.top + rect.height / 2;"
            "var opts = {bubbles: true, cancelable: true, view: window,"
            "  clientX: x, clientY: y, screenX: x, screenY: y,"
            "  button: 0, buttons: 1};"
            "el.dispatchEvent(new PointerEvent('pointerdown', opts));"
            "el.dispatchEvent(new MouseEvent('mousedown', opts));"
            "el.dispatchEvent(new PointerEvent('pointerup', opts));"
            "el.dispatchEvent(new MouseEvent('mouseup', opts));"
            "el.dispatchEvent(new MouseEvent('click', opts));"
            "return 'clicked (el.click + synthetic events)';"
            "})()"
        )


    def click(self, selector, timeout=5000):
        sel_js = _translate_selector(selector)
        # Auto-wait for element to appear
        if not self._auto_wait(sel_js, timeout):
            raise PwError(f"Element not found (timeout {timeout}ms): {selector}")
        # Batch: click + wait for potential navigation + title/url in one JXA call
        js_code = json.dumps(self._click_js(sel_js, selector))
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var urlBefore = tab.url();
        safari.doJavaScript({js_code}, {{in: tab}});
        // Wait for potential navigation (URL change or page load)
        var deadline = Date.now() + {timeout};
        delay(0.05);
        while (Date.now() < deadline) {{
            try {{
                var u = tab.url();
                if (u !== urlBefore) {{
                    // URL changed — wait for title to settle
                    delay(0.2);
                    try {{ safari.doJavaScript("document.readyState", {{in: tab}}); }} catch(e2) {{}}
                    break;
                }}
                // URL same — page didn't navigate, we're done
                break;
            }} catch(e) {{
                delay(0.2);
            }}
        }}
        JSON.stringify({{title: tab.name(), url: tab.url()}});
        '''
        self._last_nav = {}
        try:
            raw = _jxa(script, timeout=timeout // 1000 + 5)
            self._last_nav = json.loads(raw) if raw else {}
        except PwError as e:
            err = str(e)
            if "Element not found" in err:
                raise
            # JXA timeout after click is non-fatal (click succeeded, page may be loading)
            if "timed out" in err.lower():
                self._last_nav = {}
            else:
                raise

    def _react_click_js(self, sel_js, selector):
        """JS that clicks exclusively via React fiber handlers."""
        return (
            "(function(){"
            + REACT_FIBER_JS +
            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + _js_escape(selector) + ");"
            "el.scrollIntoView({block: 'center'});"
            "var fiber = __pw_getReactFiber(el);"
            "if (!fiber) { el.click(); return 'clicked (no fiber, used el.click)'; }"
            "var onMD = __pw_findHandler(fiber, 'onMouseDown');"
            "if (onMD) { try { onMD(__pw_makeSyntheticEvent(el, 'mousedown')); } catch(e) {} }"
            "var onClick = __pw_findHandler(fiber, 'onClick');"
            "if (onClick) { onClick(__pw_makeSyntheticEvent(el, 'click')); return 'clicked (react fiber onClick)'; }"
            "var onPress = __pw_findHandler(fiber, 'onPress');"
            "if (onPress) { onPress(__pw_makeSyntheticEvent(el, 'click')); return 'clicked (react fiber onPress)'; }"
            "el.click();"
            "return 'clicked (fiber found, no handler, used el.click)';"
            "})()"
        )

    def _react_set_js(self, sel_js, selector, prop, value):
        """JS that sets a React component prop by invoking its handler."""
        escaped_prop = _js_escape(prop)
        escaped_value = _js_escape(value)
        return (
            "(function(){"
            + REACT_FIBER_JS +
            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + _js_escape(selector) + ");"
            "var fiber = __pw_getReactFiber(el);"
            "if (!fiber) throw new Error('No React fiber on: ' + " + _js_escape(selector) + ");"
            "var propName = " + escaped_prop + ";"
            "var handler = __pw_findHandler(fiber, propName);"
            "if (!handler) throw new Error('No ' + propName + ' handler in fiber tree for: ' + " + _js_escape(selector) + ");"
            "var rawValue = " + escaped_value + ";"
            "var parsedValue; try { parsedValue = JSON.parse(rawValue); } catch(e) { parsedValue = rawValue; }"
            "if (propName === 'onChange') {"
            "  handler({target: {value: parsedValue}, currentTarget: {value: parsedValue},"
            "    preventDefault: function(){}, stopPropagation: function(){}});"
            "} else { handler(parsedValue); }"
            "return 'set ' + propName + ' via React fiber';"
            "})()"
        )

    def react_click(self, selector, timeout=5000):
        """Click via React fiber handlers (background-safe)."""
        sel_js = _translate_selector(selector)
        # Auto-wait for element
        if not self._auto_wait(sel_js, timeout):
            raise PwError(f"Element not found (timeout {timeout}ms): {selector}")
        js_code = json.dumps(self._react_click_js(sel_js, selector))
        script = f"""
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var urlBefore = tab.url();
        var result = safari.doJavaScript({js_code}, {{in: tab}});
        var deadline = Date.now() + {timeout};
        delay(0.05);
        while (Date.now() < deadline) {{
            try {{
                var u = tab.url();
                if (u !== urlBefore) {{
                    delay(0.2);
                    try {{ safari.doJavaScript("document.readyState", {{in: tab}}); }} catch(e2) {{}}
                    break;
                }}
                break;
            }} catch(e) {{ delay(0.2); }}
        }}
        JSON.stringify({{title: tab.name(), url: tab.url(), method: result}});
        """
        self._last_nav = {}
        try:
            raw = _jxa(script, timeout=timeout // 1000 + 5)
            info = json.loads(raw) if raw else {}
            self._last_nav = info
            return info.get("method", "clicked")
        except PwError as e:
            if "Element not found" in str(e) or "No React fiber" in str(e):
                raise
            if "timed out" in str(e).lower():
                self._last_nav = {}
                return "clicked (timed out waiting for nav)"
            raise

    def react_set(self, selector, prop, value, timeout=5000):
        """Set a React component prop via its handler (background-safe)."""
        sel_js = _translate_selector(selector)
        # Auto-wait for element
        if not self._auto_wait(sel_js, timeout):
            raise PwError(f"Element not found (timeout {timeout}ms): {selector}")
        js = self._react_set_js(sel_js, selector, prop, value)
        return self._do_js(js, timeout=timeout // 1000 + 5)

    def wait_for_load_state(self, state=None, timeout=5000):
