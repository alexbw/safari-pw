def cmd_snap():
    """Fast page state: title + URL + text in one call."""
    def do(browser, ctx, page):
        # Single JS call to get everything at once
        data = page.evaluate('''({
            title: document.title,
            url: location.href,
            text: document.body ? document.body.innerText.substring(0, 50000) : ""
        })''')
        if data:
            print(f"{data.get('title', '')}\n{data.get('url', '')}\n---")
            text = data.get("text", "")
            lines = [l.strip() for l in text.split("\n") if l.strip()]
            print("\n".join(lines[:200]))
            if len(lines) > 200:
                print(f"\n... ({len(lines) - 200} more lines)")
