    def _ng_set_js(self, sel_js, selector, value):
        """JS that sets an ng-model bound value via Angular's own API."""
        escaped_value = _js_escape(value)
        escaped_sel = _js_escape(selector)
        return (
            "(function(){"
            + ANGULAR_HELPER_JS +
            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + escaped_sel + ");"
            "var $el = __pw_ngEl(el);"
            "if (!$el) throw new Error('AngularJS not detected on page');"
            "var ctrl = $el.controller('ngModel');"
            "if (!ctrl) throw new Error('No ng-model controller on: ' + " + escaped_sel + ");"
            "var scope = __pw_ngScope(el);"
            "var v = " + escaped_value + ";"
            "__pw_ngApply(scope, function() {"
            "  ctrl.$setViewValue(v);"
