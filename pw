def cmd_doctor():
    """Check Safari automation prerequisites."""
    print("Safari automation setup check\n")
    ok = True

    # 1. Safari installed
    safari_path = "/Applications/Safari.app"
    if os.path.exists(safari_path):
        print("  [ok] Safari installed")
    else:
        print("  [FAIL] Safari not found at /Applications/Safari.app")
        ok = False

    # 2. Automation permission (try to talk to Safari)
    try:
        _jxa('Application("Safari").name();')
        print("  [ok] Automation permission granted")
    except PwError as e:
        if "not authorized" in str(e).lower() or "(-1743)" in str(e):
            print("  [FAIL] Automation permission denied")
            print("         → System Settings > Privacy & Security > Automation")
            print("         → Enable your terminal for Safari")
            ok = False
        else:
            print(f"  [ok] Can reach Safari (may need to approve dialog on first real use)")

    # 3. Allow JavaScript from Apple Events. Create a throwaway window
    # for the probe rather than poking at safari.windows[0].currentTab
    # (the user's frontmost tab). The probe window is closed immediately.
    try:
        _jxa('''
        var safari = Application("Safari");
        safari.launch();
        delay(0.3);
        var before = {};
        for (var b = 0; b < safari.windows.length; b++) {
            try { before[safari.windows[b].id()] = true; } catch(e) {}
        }
        safari.Document().make();
        delay(0.2);
        var probeWin = null;
        for (var k = 0; k < safari.windows.length; k++) {
            try {
                var kid = safari.windows[k].id();
                if (!before[kid]) { probeWin = safari.windows[k]; break; }
            } catch(e) {}
        }
        if (probeWin) {
            try { probeWin.bounds = {x: -32000, y: -32000, width: 800, height: 600}; } catch(e) {}
            safari.doJavaScript("1+1", {in: probeWin.currentTab});
            try { probeWin.close(); } catch(e) {}
        } else {
            throw new Error("could not create probe window");
        }
        ''')
        print("  [ok] 'Allow JavaScript from Apple Events' is enabled")
    except PwError as e:
        err = str(e)
        if "apple events" in err.lower() or "(-1743)" in err:
            print("  [FAIL] 'Allow JavaScript from Apple Events' is disabled")
            print("         → Safari > Settings > Advanced > 'Show features for web developers'")
            print("         → Safari > Settings > Developer > 'Allow JavaScript from Apple Events'")
            ok = False
        else:
            print(f"  [warn] Could not verify JS permissions: {e}")

    # 4. Accessibility (optional, for type/press)
    try:
        _jxa('''
        Application("System Events").keystroke("");
        "ok";
        ''')
        print("  [ok] Accessibility permission (for PW_KEYSTROKE=1 type/press)")
    except PwError:
        print("  [info] Accessibility permission not granted")
        print("         → only needed if you set PW_KEYSTROKE=1 to force OS-level keystrokes")
        print("         → System Settings > Privacy & Security > Accessibility > enable terminal")

    print()
    if ok:
        print("Safari automation is ready! Use: pw nav <url>")
    else:
        print("Fix the issues above, then run 'pw doctor' again.")


