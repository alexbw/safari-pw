    def fill_search(self, selector, text, timeout=8000):
        """Fill a search input in a React SPA (e.g., Instacart).

        Handles the two-phase pattern common in modern SPAs:
        1. Click the visible search trigger to open the search modal/overlay
        2. Find the actual input that receives keyboard focus
        3. Fill it using native setter + React fiber onChange
        4. Submit by dispatching Enter keydown event

        Returns the page text after submission for result scanning.
        """
        self._last_nav = {}
        sel_js = _translate_selector(selector)
        escaped_text = _js_escape(text)

        # Phase 1: Click the trigger element and wait for the real input
        # Phase 2: Find the focused/modal input, fill it, and press Enter
        js = (
            "(function(){"
            + REACT_FIBER_JS +
            # Click the visible trigger element
            "var trigger = " + sel_js + ";"
            "if (!trigger) throw new Error('Trigger not found: ' + " + _js_escape(selector) + ");"
            "trigger.click(); trigger.focus();"

            # Wait briefly for modal/overlay to open
            "return new Promise(function(resolve) {"
            "  setTimeout(function() {"

            # Find the actual input: prefer the focused element if it's an input,
            # otherwise find any visible text input that appeared
            "    var target = document.activeElement;"
            "    if (!target || target === document.body || target.tagName !== 'INPUT') {"
            "      var inputs = document.querySelectorAll('input[type=text], input[type=search], input:not([type])');"
            "      var best = null;"
            "      for (var i = 0; i < inputs.length; i++) {"
            "        var r = inputs[i].getBoundingClientRect();"
            "        if (r.width > 0 && r.height > 0 && r.y > -1000) {"
            # Prefer inputs that aren't the trigger
            "          if (inputs[i] !== trigger) { best = inputs[i]; break; }"
            "        }"
            "      }"
            "      if (best) { target = best; target.focus(); }"
            "    }"
            "    if (!target || target === document.body) {"
            "      resolve('error: no input found after click');"
            "      return;"
            "    }"

            # Fill using native setter + React compat
            "    var proto = (target.tagName === 'TEXTAREA') ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;"
            "    var setter = Object.getOwnPropertyDescriptor(proto, 'value');"
            "    if (setter && setter.set) setter.set.call(target, " + escaped_text + ");"
            "    else target.value = " + escaped_text + ";"
            "    var tracker = target._valueTracker; if (tracker) tracker.setValue('');"
            "    target.dispatchEvent(new Event('input', {bubbles: true}));"
            "    target.dispatchEvent(new Event('change', {bubbles: true}));"

            # Invoke React fiber onChange if available
            "    var fiber = __pw_getReactFiber(target);"
            "    if (fiber) {"
            "      var onChange = __pw_findHandler(fiber, 'onChange');"
            "      if (onChange) {"
            "        try { onChange({target: {value: " + escaped_text + "}, currentTarget: {value: " + escaped_text + "},"
            "          preventDefault: function(){}, stopPropagation: function(){}}); } catch(e) {}"
            "      }"
            "    }"

            # Wait for suggestions to render, then submit with Enter
            "    setTimeout(function() {"
            "      target.dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true}));"
            "      target.dispatchEvent(new KeyboardEvent('keypress', {key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true}));"
            "      target.dispatchEvent(new KeyboardEvent('keyup', {key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true}));"

            # Also try form submit as fallback
            "      var form = target.closest('form');"
            "      if (form) { try { form.requestSubmit(); } catch(e) {} }"

            "      setTimeout(function() {"
            "        resolve('searched: ' + target.className.substring(0, 30));"
            "      }, 2000);"
            "    }, 500);"

            "  }, 500);"
            "});"
            "})()"
        )
        result = self._do_js(js, timeout=timeout // 1000 + 10)
        return result

    def fill(self, selector, text, timeout=5000):
        self._last_nav = {}  # mutation — invalidate cache
        sel_js = _translate_selector(selector)
        # Auto-wait for element
        if not self._auto_wait(sel_js, timeout):
            raise PwError(f"Element not found (timeout {timeout}ms): {selector}")
        escaped_text = _js_escape(text)
        # Enhanced React-compatible fill with MUI date input support.
        # 1. Native setter + valueTracker reset (standard React)
        # 2. Detect MUI date fields and invoke onChange/onAccept via React fiber
        # 3. Dispatch input/change/blur events for validation
        js = (
            "(function(){"
            + REACT_FIBER_JS +
            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + _js_escape(selector) + ");"
            "el.focus();"
            "var isMuiDate = false;"
            "if (el.type === 'tel' || el.getAttribute('role') === 'textbox') {"
            "  var p = el.closest('.MuiDatePicker-root, .MuiTextField-root, .MuiInputBase-root, [class*=MuiDateField], [class*=MuiDatePicker]');"
            "  if (p) isMuiDate = true;"
            "}"
            "var ariaLabel = (el.getAttribute('aria-label') || '').toLowerCase();"
            "if (ariaLabel.match(/date|month|year|day/)) isMuiDate = true;"
            "var proto = (el.tagName === 'TEXTAREA') ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;"
            "var nativeSetter = Object.getOwnPropertyDescriptor(proto, 'value');"
            "if (nativeSetter && nativeSetter.set) { nativeSetter.set.call(el, " + escaped_text + "); }"
            "else { el.value = " + escaped_text + "; }"
            "var tracker = el._valueTracker; if (tracker) tracker.setValue('');"
            "el.dispatchEvent(new Event('input', {bubbles: true}));"
            "el.dispatchEvent(new Event('change', {bubbles: true}));"
            "var fiber = __pw_getReactFiber(el);"
            "if (fiber) {"
            "  var onChange = __pw_findHandler(fiber, 'onChange');"
            "  if (onChange) {"
            "    try { onChange({target: {value: " + escaped_text + "}, currentTarget: {value: " + escaped_text + "},"
            "      preventDefault: function(){}, stopPropagation: function(){}}); } catch(e) {}"
            "  }"
            "  if (isMuiDate) {"
            "    var onAccept = __pw_findHandler(fiber, 'onAccept');"
            "    if (onAccept) { try { onAccept(" + escaped_text + "); } catch(e) {} }"
            "  }"
            "}"
            "el.dispatchEvent(new Event('blur', {bubbles: true}));"
            "return isMuiDate ? 'filled (MUI date)' : 'filled';"
            "})()"
        )
        self._do_js(js, timeout=timeout // 1000 + 5)

    def select_option(self, selector, value, timeout=5000):
        self._last_nav = {}  # mutation — invalidate cache
        sel_js = _translate_selector(selector)
        escaped_val = _js_escape(value)

        # Step 1: Check if it's a native <select> element
        tag_js = f'(function(){{ var el={sel_js}; return el ? el.tagName : null; }})()'
        tag = self._do_js(tag_js)

        if tag == 'SELECT':
            # Native <select> with React compatibility
            js = f'''(function(){{
                var el = {sel_js};
                if (!el) throw new Error("Element not found: " + {_js_escape(selector)});
                var setter = Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype, "value");
                if (setter && setter.set) setter.set.call(el, {escaped_val});
                else el.value = {escaped_val};
                var t = el._valueTracker; if (t) t.setValue("");
                el.dispatchEvent(new Event("change", {{bubbles: true}}));
                return "selected";
            }})()'''
            self._do_js(js, timeout=timeout // 1000 + 5)
        else:
            # Custom dropdown: click trigger to open, wait, find and click option
            click_js = self._click_js(sel_js, selector)
            self._do_js(click_js, timeout=timeout // 1000 + 5)
            time.sleep(0.3)  # wait for dropdown to render
            js = f'''(function(){{
                var val = {escaped_val};
                var selectors = [
                    "[role='option']", "[role='listbox'] li",
                    ".MuiMenuItem-root", ".a-dropdown-item a",
                    "ul[role='listbox'] > li", ".dropdown-item", "li[data-value]"
                ];
                var options = document.querySelectorAll(selectors.join(", "));
                for (var i = 0; i < options.length; i++) {{
                    var opt = options[i];
                    var text = opt.textContent.trim();
                    var dataVal = opt.getAttribute("data-value") || "";
                    if (text === val || dataVal === val) {{
                        opt.scrollIntoView({{block: "center"}});
                        opt.click();
                        return "selected";
                    }}
                }}
                throw new Error("Option not found: " + val);
            }})()'''
            self._do_js(js, timeout=timeout // 1000 + 5)

    def screenshot(self, path=None, full_page=False):
        path = path or SCREENSHOT_DEFAULT
        # Normalize to an absolute path before passing to `screencapture`.
        # `screencapture -x foo` would treat a `-`-prefixed filename like
        # `-T10` as a flag, not a path; absolute paths begin with '/' and
        # are unambiguous.
        path = os.path.abspath(os.path.expanduser(path))
        # screencapture -l<windowID> reads from the window-server backing
        # store, so it works even when Safari is occluded or in the
        # background. We switch the pw tab to be Safari's currentTab (so
        # the right page is in the backing buffer), capture, then restore
        # the user's original tab. No safari.activate() — fully backgrounded.
        #
        # Every step is wrapped in try/catch on the JXA side. We must NEVER
        # fall back to a full-screen `screencapture -x` without a window id:
        # that captures whatever app happens to be frontmost (terminal, an
        # email window, anything) and silently leaks unrelated content as
        # what looked like a Safari screenshot.
        info_raw = _jxa(f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var win = __pw_win;
        var winId = null, origIdx = 0;
        try {{ winId = win.id(); }} catch(e) {{}}
        try {{
            var cur = win.currentTab();
            for (var i = 0; i < win.tabs.length; i++) {{
                if (win.tabs[i].id() === cur.id()) {{ origIdx = i; break; }}
            }}
        }} catch(e) {{}}
        try {{ if (__pw_tab) win.currentTab = __pw_tab; }} catch(e) {{}}
        JSON.stringify({{windowId: winId, originalTab: origIdx}});
        ''')
        try:
            info = json.loads(info_raw) if info_raw else {}
        except json.JSONDecodeError:
            info = {}
        win_id_raw = info.get("windowId")
        original_tab = _coerce_index(info.get("originalTab", 0))
        win_id = str(win_id_raw) if win_id_raw is not None else ""
        if not win_id or not win_id.isdigit():
            raise PwError(
                "screenshot failed: could not resolve a Safari window id "
                "(Safari may have no windows open). Refusing to fall back to "
                "a full-screen capture — that would leak whatever app is "
                "frontmost."
            )
        # Remove any stale file at the path so a missing file genuinely
        # indicates capture failure (vs. capture-ran-but-overwrote-nothing).
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        except OSError:
            pass
        subprocess.run(
            ["screencapture", f"-l{win_id}", "-x", path],
            capture_output=True, timeout=10,
        )
        if not os.path.exists(path):
            raise PwError(
                f"screenshot capture failed for Safari window {win_id} "
                f"(no file written to {path})"
            )
        # Restore the previously-current tab inside pw's own window. Since
        # pw runs in a dedicated Safari window (separate from any user
        # window), this swap never touches the user's tabs — but we still
        # restore so that another pw tab the caller was on stays current.
        try:
            finder = self._find_tab_jxa()
            _jxa(
                f'var safari = Application("Safari"); {finder} '
                f'try {{ __pw_win.currentTab = __pw_win.tabs[{original_tab}]; }} catch(e) {{}}'
            )
        except PwError:
            pass

    def dismiss_popups(self):
        """Dismiss common popups, cookie banners, and marketing modals."""
        js = '''(function(){
            var dismissed = [];
            // Try common close button selectors
            var closeSelectors = [
                '[aria-label="Close"]', '[aria-label="close"]', '[aria-label="Dismiss"]',
                '[aria-label*="close" i]', '[aria-label*="dismiss" i]',
                'button[class*="close"]', '[data-testid="close"]', '[data-dismiss]',
                '.modal-close', '.popup-close', '.close-btn',
                '[class*="cookie"] button', '[id*="cookie"] button',
                '[class*="consent"] button', '[id*="consent"] button'
            ];
            for (var i = 0; i < closeSelectors.length; i++) {
                var els = document.querySelectorAll(closeSelectors[i]);
                for (var j = 0; j < els.length; j++) {
                    try { els[j].click(); dismissed.push(closeSelectors[i]); } catch(e) {}
                }
            }
            // Try buttons with common accept/close text
            var btns = document.querySelectorAll('button');
            for (var k = 0; k < btns.length; k++) {
                var txt = btns[k].textContent.trim().toLowerCase();
                if (txt === 'accept' || txt === 'close' || txt === 'got it' ||
                    txt === 'accept all' || txt === 'ok' || txt === 'i agree' ||
                    txt === 'dismiss' || txt === 'no thanks') {
                    try { btns[k].click(); dismissed.push('button:' + txt); } catch(e) {}
                }
            }
            // Remove high z-index overlays
            var all = document.querySelectorAll('div');
            for (var m = 0; m < all.length; m++) {
                var style = window.getComputedStyle(all[m]);
                if (parseInt(style.zIndex) > 9000 && style.position === 'fixed' &&
                    parseFloat(style.opacity) < 1) {
                    all[m].remove(); dismissed.push('overlay');
                }
            }
            // Unlock body scroll
            document.body.style.overflow = '';
            document.documentElement.style.overflow = '';
            return dismissed.length > 0 ? 'dismissed: ' + dismissed.join(', ') : 'nothing to dismiss';
        })()'''
        return self._do_js(js) or "nothing to dismiss"

    def query_selector(self, selector):
        sel_js = _translate_selector(selector)
        js = f'({sel_js}) ? "found" : null'
        result = self._do_js(js)
        if not result or result == "null":
            return None
        return _SafariElement(sel_js, self._tab, self._win, session_id=self._session_id)

    def inner_text(self, selector):
        sel_js = _translate_selector(selector)
        js = f'(function(){{ var el={sel_js}; return el ? el.innerText : ""; }})()'
        return self._do_js(js) or ""

    def content(self):
        js = 'document.documentElement.outerHTML.substring(0, 100000)'
        return self._do_js(js) or ""

    def evaluate(self, js):
        # Auto-wrap multi-statement JS in IIFE so Safari returns the last value
        js = _wrap_multi_statement_js(js)
        # Wrap user JS to serialize the result for transport through JXA.
        # Use a function body with direct code insertion (not eval()) to avoid
        # double-escaping issues with complex JS expressions.
        wrapper = f'''(function(){{
            try {{
                var __r = {js};
                if (__r === undefined || __r === null) return "null";
                if (typeof __r === "object") return JSON.stringify(__r);
                return String(__r);
            }} catch(e) {{
                return JSON.stringify({{"__error": e.message}});
            }}
        }})()'''
        raw = self._do_js(wrapper)
        if raw is None or raw == "null":
            return None
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, dict) and "__error" in parsed:
                raise PwError(f"JS error: {parsed['__error']}")
            return parsed
        except json.JSONDecodeError:
            return raw

    def wait_for_selector(self, selector, timeout=10000):
        sel_js = _translate_selector(selector)
        check_js = json.dumps(f'({sel_js}) ? "found" : "nope"')
        timeout_s = max(timeout // 1000, 1)
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var deadline = Date.now() + {timeout};
        while (Date.now() < deadline) {{
            try {{
                var r = safari.doJavaScript({check_js}, {{in: tab}});
                if (r === "found") {{ "found"; break; }}
            }} catch(e) {{}}
            delay(0.1);
        }}
        '''
        result = _jxa(script, timeout=timeout_s + 5)
        if result != "found":
            raise PwError(f"Timeout waiting for: {selector}")

    def go_back(self, wait_until=None, timeout=5000):
        # Batch: trigger back, wait for load, return title+url
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var oldUrl = tab.url();
        safari.doJavaScript("history.back()", {{in: tab}});
        delay(0.1);
        var deadline = Date.now() + {timeout};
        while (Date.now() < deadline) {{
            try {{
                var u = tab.url();
                if (u !== oldUrl) break;
            }} catch(e) {{}}
            delay(0.2);
        }}
        JSON.stringify({{title: tab.name(), url: tab.url()}});
        '''
        try:
            raw = _jxa(script, timeout=timeout // 1000 + 5)
            self._last_nav = json.loads(raw) if raw else {}
        except (PwError, json.JSONDecodeError):
            self._last_nav = {}


def _safari_session_file():
    """Return the state file path for the current session."""
    name = _session_name
    if name:
        # _session_name is validated by _safe_session_name() at parse time,
        # but re-validate defensively in case it's set programmatically.
        safe = _safe_session_name(name)
        return os.path.join(STATE_DIR, f"session-{safe}.json")
    return SAFARI_TAB_FILE


def _coerce_index(value, default=0):
    """Coerce a persisted index to a non-negative int. Indices flow into JXA
    via f-strings (safari.windows[N].tabs[N]); a tampered state file with a
    string value would otherwise inject arbitrary JXA. Reject anything that
    isn't a plain non-negative integer."""
    if isinstance(value, bool):
        return default  # bool is a subclass of int but not what we want
    if isinstance(value, int) and value >= 0:
        return value
    return default


def _sanitize_state(state):
    """Re-coerce index fields read from disk before they cross into JXA."""
    if not isinstance(state, dict):
        return None
    state["tab_index"] = _coerce_index(state.get("tab_index", 0))
    state["window_index"] = _coerce_index(state.get("window_index", 0))
    sid = state.get("session_id", "")
    if not isinstance(sid, str):
        sid = ""
    state["session_id"] = sid
    url = state.get("url", "")
    if not isinstance(url, str):
        url = ""
    state["url"] = url
    # window_id: Safari's stable per-window integer id. Optional — older
    # state files won't have one; the resolver will record one on next use.
    wid = state.get("window_id")
    if isinstance(wid, bool) or not isinstance(wid, int) or wid <= 0:
        wid = None
    state["window_id"] = wid
    return state


def _read_tab_state():
    """Read the persisted Safari tab state. Returns dict or None."""
    path = _safari_session_file()
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            raw = f.read().strip()
        # Handle legacy integer format
        try:
            idx = int(raw)
            return {"tab_index": idx}
        except ValueError:
            pass
        return _sanitize_state(json.loads(raw))
    except (OSError, json.JSONDecodeError):
        return None


def _write_tab_state(state):
    """Persist tab state for the current session."""
    _safe_json_write(_safari_session_file(), state)


def _safari_tab_index():
    """Read the persisted Safari tab index."""
    state = _read_tab_state()
    if not state:
        return 0
    return state.get("tab_index", 0)


# Sweep grace period: a registry entry younger than this is considered
# "still being set up" and won't be closed by the orphan sweep even if
# its tabs look like placeholders. Window creation + first nav is
# typically <2s; 60s leaves plenty of headroom for slow sites.
PW_SWEEP_GRACE_SECONDS = 60


def _registry_lock_path():
    return PW_WINDOW_REGISTRY + ".lock"


def _read_window_registry():
    """Return {window_id: registered_at_unix_ts} for every pw-owned
    window. Tolerates the legacy list-of-ids format (no timestamp →
    treated as registered "now" so they age in normally).
    """
    if not os.path.exists(PW_WINDOW_REGISTRY):
        return {}
    try:
        with open(PW_WINDOW_REGISTRY) as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}
    now = time.time()
    out = {}
    if isinstance(data, list):
        # Legacy format: [id, id, ...] — no timestamp. Pretend they
        # were just registered so the grace period applies; better
        # safe than aggressive on upgrade.
        for x in data:
            if isinstance(x, int) and not isinstance(x, bool) and x > 0:
                out[int(x)] = now
    elif isinstance(data, dict):
        for k, v in data.items():
            try:
                wid = int(k)
                ts = float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else now
                if wid > 0:
                    out[wid] = ts
            except (ValueError, TypeError):
                continue
    return out


def _write_window_registry(entries):
    """Persist the registry. `entries` is a dict {window_id: ts}."""
    # JSON object keys must be strings.
    _safe_json_write(
        PW_WINDOW_REGISTRY,
        {str(k): float(v) for k, v in entries.items()},
    )


def _registry_rmw(mutator):
    """Read-modify-write the registry under an advisory file lock so
    concurrent pw processes don't lose each other's entries. `mutator`
    takes the dict and mutates it in place (or returns a new dict)."""
    _ensure_state_dir()
    lock_path = _registry_lock_path()
    # Open the lock file separately from the registry file so the lock
    # survives O_TRUNC on the registry itself.
    try:
        lock_fd = os.open(lock_path, os.O_WRONLY | os.O_CREAT, 0o600)
    except OSError:
        # If we can't get a lock, fall back to lock-free RMW. Worst case
        # is registry leakage (a window id gets lost), which is
        # recoverable via boot-time sweep on next run.
        entries = _read_window_registry()
        result = mutator(entries)
        if result is not None:
            entries = result
        _write_window_registry(entries)
        return
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
        except OSError:
            pass
        entries = _read_window_registry()
        result = mutator(entries)
        if result is not None:
            entries = result
        _write_window_registry(entries)
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(lock_fd)


def _register_pw_window(window_id):
    """Add a window id to the pw-owned registry with a current
    timestamp. Held under advisory lock so concurrent pw processes
    don't lose entries via O_TRUNC."""
    if not window_id:
        return
    wid = int(window_id)
    now = time.time()
    def _add(entries):
        entries[wid] = now
    _registry_rmw(_add)


def _new_session_id():
    """Mint a pw session id.

    For named sessions (--name / PW_SESSION), the id is deterministic from
    the name. That way repeated invocations of the same name resolve to the
    same managed tab via the JS marker, even if state files are lost or the
    tab indices drift. Without this, every recovery path mints a fresh id,
    orphaning any placeholder tabs created under the previous one.

    Unnamed sessions still get a unique per-process id.
    """
    global _session_counter
    if _session_name:
        return f"pw_named_{_session_name}"
    _session_counter += 1
    return f"pw_{os.getpid()}_{int(time.time() * 1000) % 1000000}_{_session_counter}"


# Z-order target for the pw window. 999 = behind every other Safari window;
# 1 = frontmost-in-Safari (debug mode, set PW_VISIBLE=1).
_PW_BURY_INDEX = 999


def _bury_pw_window(window_id):
    """Push a Safari window to the back of Safari's window z-order so the
    user's frontmost Safari window stays on top. JXA's `w.index = N`
    silently fails on current Safari; the AppleScript equivalent works
    and persists across navigations.

    The window is not minimized (no Dock clutter) and is full-size so
    page rendering and screencapture work. It's just occluded behind
    the user's Safari window. PW_VISIBLE=1 brings it forward instead.
    """
    if not window_id:
        return
    target = 1 if os.environ.get("PW_VISIBLE") == "1" else _PW_BURY_INDEX
    _osascript(
        f'tell application "Safari" to '
        f'set index of (every window whose id is {int(window_id)}) to {target}'
    )


def _close_pw_window(window_id):
    """Destroy a pw Safari window. AppleScript `close` actually closes;
    JXA's `safari.windows[i].close()` leaves the window stranded with a
    default favorites:// tab. (Safari still keeps a zero-tab phantom in
    `safari.windows[]` afterwards — the sweep handles those.)"""
    if not window_id:
        return
    _osascript(
        f'tell application "Safari" to '
        f'close (every window whose id is {int(window_id)})'
    )
    wid_int = int(window_id)
    def _drop(entries):
        entries.pop(wid_int, None)
    _registry_rmw(_drop)


def _sweep_orphan_pw_windows(spare_window_id=None):
    """Boot-time sweep: for every window id in the pw registry that's
    OLDER than the grace period, check if the window still exists and
    whether it's an orphan (only blank / pw placeholder tabs). Orphans
    get closed; ids whose window has disappeared get pruned.

    The grace period (PW_SWEEP_GRACE_SECONDS) protects in-flight
    creates: a concurrent pw process may have just registered a window
    but not yet pushed its real tab, and we don't want this process to
    kill it for "looking orphan-like" in that small interval.

    `spare_window_id` is excluded unconditionally — typically the
    caller's own working window.
    """
    entries = _read_window_registry()
    if not entries:
        return
    now = time.time()
    grace = PW_SWEEP_GRACE_SECONDS
    targets = [
        wid for wid, ts in entries.items()
        if wid != spare_window_id and (now - ts) >= grace
    ]
    if not targets:
        return
    ids_js = json.dumps(targets)
    # Returns the subset of ids that are alive AND look orphan-like.
    # Orphan = every tab is favorites://, about:blank, "", or a pw
    # marker data: URL. A tab pointing to a real http(s) URL means
    # someone is using the window, leave it alone.
    #
    # A window with ZERO tabs is treated as already-dead (phantom from
    # a prior close — AppleScript `close` can't fully destroy a Safari
    # window). Those get pruned from the registry but we don't try to
    # close them again.
    scan = f'''
    var safari = Application("Safari");
    var targets = {ids_js};
    var dead = [];
    var orphan = [];
    for (var k = 0; k < targets.length; k++) {{
        var found = false;
        for (var w = 0; w < safari.windows.length; w++) {{
            try {{
                if (safari.windows[w].id() === targets[k]) {{
                    found = true;
                    var win = safari.windows[w];
                    if (win.tabs.length === 0) {{
                        // Phantom — already effectively closed.
                        dead.push(targets[k]);
                        break;
                    }}
                    var allBlank = true;
                    for (var t = 0; t < win.tabs.length; t++) {{
                        try {{
                            var u = win.tabs[t].url() || "";
                            var isBlank = (
                                u === "favorites://" ||
                                u === "about:blank" ||
                                u === "" ||
                                u.indexOf("data:text/html") === 0
                            );
                            if (!isBlank) {{ allBlank = false; break; }}
                        }} catch(e) {{ allBlank = false; break; }}
                    }}
                    if (allBlank) orphan.push(targets[k]);
                    break;
                }}
            }} catch(e) {{}}
        }}
        if (!found) dead.push(targets[k]);
    }}
    JSON.stringify({{dead: dead, orphan: orphan}});
    '''
    try:
        raw = _jxa(scan, timeout=10)
        result = json.loads(raw) if raw else {}
    except (PwError, json.JSONDecodeError):
        return
    dead = result.get("dead", [])
    orphans = result.get("orphan", [])
    # Close orphan windows. Dead ids just get pruned from the registry.
    for wid in orphans:
        _close_pw_window(wid)  # also prunes registry
    if dead:
        dead_ints = {int(x) for x in dead}
        def _prune(entries):
            for w in dead_ints:
                entries.pop(w, None)
        _registry_rmw(_prune)


def _safari_create_new_tab(session_id=None, existing_window_id=None):
    """Find or create this session's dedicated Safari window, push a tab
    into it, navigate to the session-marker data: URL, and return its
    coordinates.

    Each pw session owns exactly one Safari window — no sharing across
    sessions, no in-page-marker-based reuse, no chance of grabbing the
    user's window by accident. When the session's window is gone (Safari
    quit, user closed it, never existed), we make a new one. On every
    creation the window is buried via `set index = 999` (back of Safari's
    z-order), so when the user is in Safari they see THEIR window;
    pw's window is occluded behind it.

    Returns (window_index, tab_index, session_id, window_id). The data:
    URL bakes in the session marker so the resolver can find this tab
    on the next command without waiting for nav() to re-inject.
    """
    sid = session_id or _new_session_id()
    blank_html = (
        f"<!doctype html><title>pw</title>"
        f"<script>window.__pw_session_id={json.dumps(sid)};"
        f"window.__pw_managed=true;</script>"
    )
    data_url = "data:text/html;charset=utf-8," + urllib.parse.quote(blank_html)
    url_js = json.dumps(data_url)
    # Only the hint id is a reuse candidate. The registry exists for
    # orphan cleanup, not for cross-session lookup — trusting in-page
    # markers as a window-ownership signal is unsafe because the user
    # can navigate any tab away from a pw URL, leaving a stale marker
    # on a tab in their own window.
    hint_js = json.dumps(int(existing_window_id)) if existing_window_id else "null"

    # Phase 1: find or create the pw window, capture its id.
    locate_script = f'''
    var safari = Application("Safari");
    var hintId = {hint_js};
    var win = null;
    var created = false;

    // 1. Reuse this session's recorded window if it's still alive.
    if (hintId !== null) {{
        for (var i = 0; i < safari.windows.length; i++) {{
            try {{
                if (safari.windows[i].id() === hintId) {{ win = safari.windows[i]; break; }}
            }} catch(e) {{}}
        }}
    }}

    // 2. Otherwise create a fresh window. We never call safari.activate();
    // the Python layer will bury it via AppleScript next.
    if (!win) {{
        var before = {{}};
        for (var b = 0; b < safari.windows.length; b++) {{
            try {{ before[safari.windows[b].id()] = true; }} catch(e) {{}}
        }}
        safari.Document().make();
        // Poll until the new window id appears (typically 20-50ms),
        // with a 500ms cap so we don't hang on a Safari hiccup.
        var locDeadline = Date.now() + 500;
        while (Date.now() < locDeadline && !win) {{
            for (var k = 0; k < safari.windows.length; k++) {{
                try {{
                    var kid = safari.windows[k].id();
                    if (!before[kid]) {{ win = safari.windows[k]; created = true; break; }}
                }} catch(e) {{}}
            }}
            if (!win) delay(0.02);
        }}
    }}

    if (!win) {{ throw new Error("could not create pw Safari window"); }}
    var winId = null;
    try {{ winId = win.id(); }} catch(e) {{}}
    JSON.stringify({{window_id: winId, created: created}});
    '''
    locate_raw = _jxa(locate_script)
    try:
        locate = json.loads(locate_raw) if locate_raw else {}
    except json.JSONDecodeError:
        locate = {}
    new_win_id = locate.get("window_id")
    if not new_win_id:
        raise PwError("could not resolve pw Safari window id")

    # Register the window as pw-owned (so the boot-time sweep can prune
    # it later if the session never closes cleanly). Then bury it. The
    # bury runs BEFORE we push a tab so the navigation that follows
    # happens on a backgrounded window.
    _register_pw_window(new_win_id)
    if locate.get("created"):
        _bury_pw_window(new_win_id)

    # Phase 2: push a tab, navigate to the marker data: URL, wait for
    # readyState. After the load we re-assert bury since Safari may
    # surface a window when a new tab finishes loading.
    push_script = f'''
    var safari = Application("Safari");
    var targetId = {json.dumps(new_win_id)};
    var win = null, winIdx = -1;
    for (var i = 0; i < safari.windows.length; i++) {{
        try {{ if (safari.windows[i].id() === targetId) {{ win = safari.windows[i]; winIdx = i; break; }} }} catch(e) {{}}
    }}
    if (!win) {{ throw new Error("pw window vanished between locate and push"); }}

    // Push tab, then assign URL. Safari's JXA Tab() constructor doesn't
    // accept {{url: ...}}; the URL must be set after push.
    var newTab = safari.Tab();
    win.tabs.push(newTab);
    var tabIdx = win.tabs.length - 1;
    win.tabs[tabIdx].url = {url_js};

    // Poll readyState so the tab is actually navigable when we return.
    var deadline = Date.now() + 2000;
    while (Date.now() < deadline) {{
        try {{
            var rs = safari.doJavaScript("document.readyState", {{in: win.tabs[tabIdx]}});
            if (rs === "complete") break;
        }} catch(e) {{}}
        delay(0.05);
    }}

    // Re-resolve winIdx in case window order shifted while we waited.
    for (var m = 0; m < safari.windows.length; m++) {{
        try {{
            if (safari.windows[m].id() === targetId) {{ winIdx = m; break; }}
        }} catch(e) {{}}
    }}

    JSON.stringify({{window_index: winIdx, tab_index: tabIdx, window_id: targetId}});
    '''
    raw = _jxa(push_script)
    result = json.loads(raw) if raw else {}
    # Only re-bury when we created the window — a reused buried window
    # stays buried across a tab push (verified via System Events frontmost
    # poll). The first-create bury already happened above.
    if locate.get("created"):
        _bury_pw_window(new_win_id)
    return (
        result.get("window_index", 0),
        result.get("tab_index", 0),
        sid,
        result.get("window_id"),
    )


def _resolve_safari_tab(create_if_missing=False):
    """Resolve the correct Safari (window_idx, tab_idx, session_id).

    Uses session marker (window.__pw_session_id) first, then URL match
    (only if the matched tab also carries __pw_managed), then creates a
    fresh managed tab. NEVER returns indices that point at a tab pw
    didn't create — returning (0, 0, '') would target whatever tab the
    user has frontmost.

    Returns (window_idx, tab_idx, session_id).
    """
    state = _read_tab_state()
    if not state:
        # No state — always create a fresh managed tab in pw's own window.
        win_idx, tab_idx, sid, win_id = _safari_create_new_tab()
        _write_tab_state({
            "session_id": sid,
            "url": "",
            "tab_index": tab_idx,
            "window_index": win_idx,
            "window_id": win_id,
        })
        return (win_idx, tab_idx, sid)

    session_id = state.get("session_id", "")
    stored_url = state.get("url", "")
    stored_idx = state.get("tab_index", 0)
    stored_win = state.get("window_index", 0)
    stored_win_id = state.get("window_id")

    # For named sessions, also accept the deterministic marker. State files
    # written before deterministic sids existed have random ids; both should
    # resolve to the same tab.
    sid_candidates = []
    if session_id:
        sid_candidates.append(session_id)
    if _session_name:
        det_sid = f"pw_named_{_session_name}"
        if det_sid not in sid_candidates:
            sid_candidates.append(det_sid)

    # Scan ALL windows and tabs for the session marker. URL-match is a
    # secondary signal — only trust it if the matched tab ALSO carries a
    # __pw_managed flag, because users can navigate any tab to any URL.
    scan_js = f'''
    var safari = Application("Safari");
    var markerWin = -1, markerTab = -1, markerSid = "";
    var urlWin = -1, urlTab = -1;
    var sidCandidates = {json.dumps(sid_candidates)};
    var targetUrl = {json.dumps(stored_url)};
    var winCount = safari.windows.length;
    for (var w = 0; w < winCount; w++) {{
        var tabCount = safari.windows[w].tabs.length;
        for (var t = 0; t < tabCount; t++) {{
            try {{
                if (sidCandidates.length > 0 && markerWin < 0) {{
                    var sid = safari.doJavaScript("window.__pw_session_id || ''", {{in: safari.windows[w].tabs[t]}});
                    if (sid) {{
                        for (var i = 0; i < sidCandidates.length; i++) {{
                            if (sid === sidCandidates[i]) {{
                                markerWin = w; markerTab = t; markerSid = sid;
                                break;
                            }}
                        }}
                        if (markerWin >= 0) break;
                    }}
                }}
            }} catch(e) {{}}
            try {{
                if (targetUrl && urlWin < 0) {{
                    var u = safari.windows[w].tabs[t].url();
                    if (u === targetUrl) {{
                        var managed = safari.doJavaScript(
                            "window.__pw_managed === true ? 1 : 0",
                            {{in: safari.windows[w].tabs[t]}}
                        );
                        if (managed === 1) {{ urlWin = w; urlTab = t; }}
                    }}
                }}
            }} catch(e) {{}}
        }}
        if (markerWin >= 0) break;
    }}
    JSON.stringify({{markerWin: markerWin, markerTab: markerTab, markerSid: markerSid, urlWin: urlWin, urlTab: urlTab, winCount: winCount}});
    '''
    try:
        raw = _jxa(scan_js, timeout=15)
        result = json.loads(raw) if raw else {}
        marker_win = result.get("markerWin", -1)
        marker_tab = result.get("markerTab", -1)
        marker_sid = result.get("markerSid", "") or session_id
        url_win = result.get("urlWin", -1)
        url_tab = result.get("urlTab", -1)

        if marker_win >= 0 and marker_tab >= 0:
            new_state_needed = (
                marker_win != stored_win
                or marker_tab != stored_idx
                or (marker_sid and marker_sid != session_id)
                or stored_win_id is None
            )
            if new_state_needed:
                state["tab_index"] = marker_tab
                state["window_index"] = marker_win
                if marker_sid:
                    state["session_id"] = marker_sid
                # Capture window_id for the located window so future tab
                # creations can reuse it directly.
                try:
                    wid_raw = _jxa(
                        f'Application("Safari").windows[{marker_win}].id();',
                        timeout=3,
                    )
                    wid = int(wid_raw) if wid_raw and wid_raw.isdigit() else None
                    if wid:
                        state["window_id"] = wid
                except (PwError, ValueError):
                    pass
                _write_tab_state(state)
            return (marker_win, marker_tab, marker_sid)
        if url_win >= 0 and url_tab >= 0:
            if url_win != stored_win or url_tab != stored_idx:
                state["tab_index"] = url_tab
                state["window_index"] = url_win
                _write_tab_state(state)
            return (url_win, url_tab, session_id)

        # Neither marker nor managed-URL match. Tab is gone (closed, or
        # user-navigated and we refuse to reclaim it). Mint a fresh tab
        # in pw's own window, reusing stored window_id when valid.
        win_idx, tab_idx, sid, win_id = _safari_create_new_tab(
            existing_window_id=stored_win_id
        )
        state["tab_index"] = tab_idx
        state["window_index"] = win_idx
        state["session_id"] = sid
        state["url"] = ""
        state["window_id"] = win_id
        _write_tab_state(state)
        return (win_idx, tab_idx, sid)
    except (PwError, json.JSONDecodeError):
        pass

    # Scan failed (Safari error). Last resort: create a fresh tab. Still
    # NEVER return stored indices — they may now point at a user tab.
    win_idx, tab_idx, sid, win_id = _safari_create_new_tab(
        existing_window_id=stored_win_id
    )
    state["tab_index"] = tab_idx
    state["window_index"] = win_idx
    state["session_id"] = sid
    state["url"] = ""
    state["window_id"] = win_id
    _write_tab_state(state)
    return (win_idx, tab_idx, sid)


def safari_launch():
    """Ensure Safari is running. Stays in background — does NOT touch any
    existing user window, does NOT create a window (pw creates its own
    dedicated window when it needs one). Inspecting the user's frontmost
    tab here would itself be a form of taking-over-a-tab-we-don't-own."""
    script = '''
    var safari = Application("Safari");
    safari.launch();
    delay(0.2);
    JSON.stringify({windows: safari.windows.length});
    '''
    raw = _jxa(script)
    info = json.loads(raw) if raw else {}
    print(f"Safari ready. {info.get('windows', '?')} window(s) open.")


def safari_close():
    """Tear down this session's pw Safari window and remove its state file.

    Per-session windows are not shared, so closing a session is a single
    AppleScript `close window N` against the id recorded in state. We also
    sweep any orphan windows still in the registry — windows from earlier
    sessions that crashed without calling close — so they don't pile up.
    """
    if _session_name:
        path = _safari_session_file()
        state = _read_tab_state()
        win_id = state.get("window_id") if state else None
        if win_id:
            _close_pw_window(int(win_id))
        if os.path.exists(path):
            os.unlink(path)
        # Sweep any other registry-tracked orphans (windows from crashed
        # sessions whose state file is gone but window still exists).
        _sweep_orphan_pw_windows()
        print(f"Session {_session_name!r} closed.")
        return

    # Unnamed: scrub all state files AND close any orphan pw windows.
    import glob as _glob
    paths = [SAFARI_TAB_FILE]
    paths += _glob.glob(os.path.join(STATE_DIR, "session-*.json"))
    # Legacy path cleanup (pre-rename); harmless if nothing matches.
    paths += _glob.glob("/tmp/pw-safari-session-*.json")
    if os.path.exists("/tmp/pw-safari-tab"):
        paths.append("/tmp/pw-safari-tab")
    for path in paths:
        try:
            if os.path.exists(path):
                os.unlink(path)
        except OSError:
            pass
    # Close every window we know about. This is a full reset.
    for wid in list(_read_window_registry()):
        _close_pw_window(wid)
    print("Safari state cleaned. (Safari left running)")


def safari_status():
    """Check if Safari is running."""
    running = subprocess.run(["pgrep", "-x", "Safari"], capture_output=True).returncode == 0
    if running:
        try:
            raw = _jxa('''
            var safari = Application("Safari");
            JSON.stringify({windows: safari.windows.length, tabs: safari.windows.length > 0 ? safari.windows[0].tabs.length : 0});
            ''')
            info = json.loads(raw)
            print(f"Safari running. {info['windows']} window(s), {info['tabs']} tab(s).")
        except PwError:
            print("Safari running (could not query windows).")
    else:
        print("Safari not running.")


def _safari_connect_and_run(fn):
    """Connect to Safari and execute fn(browser, ctx, page).

    Skips pgrep check — just tries JXA directly and recovers on error.
    Uses session marker for robust tab tracking.

    When a named session is active:
    - First invocation creates a dedicated tab (never hijacks user's tab)
    - If the session's tab is gone, creates a new one automatically
    """
    win_idx, tab_idx, session_id = _resolve_safari_tab(create_if_missing=True)
    page = SafariPage(tab_idx, session_id=session_id or None, window_idx=win_idx)
    ctx = _SafariCtx(window_idx=win_idx)

    # Probabilistic orphan sweep. Orphans only come from a session that
    # crashed without calling `pw close`, so they don't need bench-instant
    # cleanup — a ~1/10 firing rate amortizes the JXA scan cost across
    # commands while still pruning within seconds under any real workload.
    state_now = _read_tab_state()
    my_win_id = state_now.get("window_id") if state_now else None
    if random.random() < 0.1:
        _sweep_orphan_pw_windows(spare_window_id=my_win_id)
    # The resolver buries on create. Reused windows stay buried across
    # subsequent commands (Safari doesn't auto-promote on doJavaScript or
    # url-set), so no re-bury here.

    try:
        return fn(None, ctx, page)
    except PwError as e:
        err = str(e)
        # Tab gone (closed by user, or finder threw __PW_TAB_GONE__
        # because the marker couldn't be located). Create a new managed
        # tab in pw's own window and retry. Never fall back to the
        # user's frontmost tab.
        tab_gone_patterns = ["(-1719)", "Can't get tab", "__PW_TAB_GONE__"]
        if any(p in err for p in tab_gone_patterns):
            prior = _read_tab_state() or {}
            stored_win_id = prior.get("window_id") if isinstance(prior, dict) else None
            new_win, new_tab, new_sid, new_win_id = _safari_create_new_tab(
                existing_window_id=stored_win_id
            )
            page = SafariPage(new_tab, session_id=new_sid, window_idx=new_win)
            ctx = _SafariCtx(window_idx=new_win)
            _write_tab_state({
                "session_id": new_sid,
                "url": "",
                "tab_index": new_tab,
                "window_index": new_win,
                "window_id": new_win_id,
            })
            return fn(None, ctx, page)
        # Safari not running or no window — launch and retry once via the
        # normal create path; never assume windows[0]/tabs[0].
        recoverable = [
            "(-1719)", "Can't get window", "windows doesn't understand",
            "(-600)", "not running",
        ]
        if any(pattern in err for pattern in recoverable):
            safari_launch()
            new_win, new_tab, new_sid, new_win_id = _safari_create_new_tab()
            _write_tab_state({
                "session_id": new_sid,
                "url": "",
                "tab_index": new_tab,
                "window_index": new_win,
                "window_id": new_win_id,
            })
            page = SafariPage(new_tab, session_id=new_sid, window_idx=new_win)
            ctx = _SafariCtx(window_idx=new_win)
            return fn(None, ctx, page)
        raise


