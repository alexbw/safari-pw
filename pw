def _parse_batch_command(cmd_str):
    """Parse a batch command string into (command_name, args_list).

    Supports quoted arguments: 'fill #name "Jane Doe"'
    For eval, the JS expression is kept as a single string to preserve
    quotes and special characters: 'eval document.querySelectorAll("input")'
    Raises ValueError for empty, unknown, or under-specified commands.
    """
    import shlex
    cmd_str = cmd_str.strip()
    if not cmd_str:
        raise ValueError("Empty batch command")
    # Split off just the command name first
    first_space = cmd_str.find(" ")
    if first_space < 0:
        cmd = cmd_str
        args = []
    else:
        cmd = cmd_str[:first_space]
        rest = cmd_str[first_space + 1:].strip()
        # For eval and type, keep the rest as a single argument to preserve
        # JS syntax (quotes, parens, etc.)
        if cmd in ("eval", "type") and rest:
            args = [rest]
        elif rest:
            args = shlex.split(rest)
        else:
            args = []
    if cmd not in COMMANDS and cmd != "batch":
        raise PwError(f"Unknown command in batch: {cmd}")
    if cmd == "batch":
        raise PwError("Cannot nest batch commands")
    spec = COMMANDS[cmd]
    if len(args) < spec["min_args"]:
        raise PwError(
            f"Command '{cmd}' requires at least {spec['min_args']} arg(s), "
            f"got {len(args)}. {spec.get('usage', '')}"
        )
    return cmd, args


def _execute_batch_step(page, cmd, args):
    """Execute a single batch step against an existing page connection."""
    if cmd == "nav":
        clean, flag, flag_sel = _parse_output_flags(args)
        if not clean:
            raise PwError("nav requires a URL")
        url = clean[0]
        if not url.startswith(("http://", "https://", "file://")):
            url = "https://" + url
        page.goto(url, wait_until="domcontentloaded", timeout=30000)
        output = flag if flag is not None else "text"
        if output is False:
            output = None
        print(f"{page.title()}\n{page.url}")
        if output:
            _handle_output_flag(page, output, flag_sel)
    elif cmd == "click":
        clean, flag, flag_sel = _parse_output_flags(args)
        if not clean:
            raise PwError("click requires a SELECTOR")
        page.click(clean[0], timeout=5000)
        page.wait_for_load_state("domcontentloaded", timeout=5000)
        output = flag if flag is not None else None  # quiet by default in batch
        print(f"Clicked: {clean[0]}")
        if output:
            _handle_output_flag(page, output, flag_sel)
    elif cmd == "react-click":
        clean, flag, flag_sel = _parse_output_flags(args)
        if not clean:
            raise PwError("react-click requires a SELECTOR")
        method = page.react_click(clean[0], timeout=5000)
        output = flag if flag is not None else None
        print(f"React-clicked: {clean[0]} [{method}]")
        if output:
            _handle_output_flag(page, output, flag_sel)
    elif cmd == "react-set":
        if len(args) < 3:
            raise PwError("react-set requires SELECTOR PROP VALUE")
        result = page.react_set(args[0], args[1], args[2], timeout=5000)
        print(f"React-set: {args[0]} {args[1]}={args[2]}")
        if result:
            print(f"  Result: {result}")
    elif cmd == "fill":
        page.fill(args[0], args[1], timeout=5000)
        print(f"Filled '{args[0]}' with '{args[1]}'")
    elif cmd == "select":
        page.select_option(args[0], args[1], timeout=5000)
        print(f"Selected '{args[1]}' in '{args[0]}'")
    elif cmd == "type":
        page.keyboard.type(" ".join(args))
        print(f"Typed: {' '.join(args)}")
    elif cmd == "press":
        page.keyboard.press(args[0])
        print(f"Pressed: {args[0]}")
    elif cmd == "eval":
        js = " ".join(args)
        result = page.evaluate(js)
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        elif result is not None:
            print(result)
        else:
            print("null")
    elif cmd == "text":
        sel = args[0] if args else None
        _print_page_text(page, sel)
    elif cmd == "html":
        sel = args[0] if args else None
        _print_page_html(page, sel)
    elif cmd == "title":
        print(page.title())
    elif cmd == "url":
        print(page.url)
    elif cmd == "links":
        sel = args[0] if args else None
        _print_page_links(page, sel)
    elif cmd == "wait":
        page.wait_for_selector(args[0], timeout=10000)
        print(f"Found: {args[0]}")
    elif cmd == "screenshot":
        path = args[0] if args else SCREENSHOT_DEFAULT
        page.screenshot(path=path)
        print(f"Screenshot saved: {path}")
    else:
        raise PwError(f"Command '{cmd}' not supported in batch mode")


def cmd_batch(command_strings):
    """Execute multiple commands in a single browser connection.

    This avoids the ~200ms Python startup overhead per command, making
    multi-step workflows significantly faster.
    """
    # Pre-parse all commands to fail fast on syntax errors
    parsed = []
    for i, cs in enumerate(command_strings, 1):
        try:
            cmd, args = _parse_batch_command(cs)
            parsed.append((i, cmd, args, cs))
        except (PwError, ValueError) as e:
            raise PwError(f"Batch step {i} ({cs!r}): {e}")

    def do(browser, ctx, page):
        for step_num, cmd, args, raw in parsed:
            try:
                print(f"[{step_num}/{len(parsed)}] {raw}")
                _execute_batch_step(page, cmd, args)
            except PwError as e:
                print(f"Error at step {step_num} ({raw!r}): {e}", file=sys.stderr)
                raise

    connect_and_run(do)


