def main():
    global _session_name

    argv = sys.argv[1:]

    # Parse --name flag for named sessions (multi-agent support)
    raw_session = None
    if "--name" in argv:
        idx = argv.index("--name")
        if idx + 1 < len(argv):
            raw_session = argv[idx + 1]
            argv = argv[:idx] + argv[idx + 2:]
        else:
            print("Error: --name requires a session name", file=sys.stderr)
            sys.exit(1)
    elif os.environ.get("PW_SESSION"):
        raw_session = os.environ["PW_SESSION"]

    # Auto-session: when running inside Claude Code and no explicit session,
    # use a "claude" session so state files are distinct from manual CLI use.
    # Claude Code sets CLAUDECODE=1 (no underscore) — accept several variants
    # in case the entrypoint shape changes.
    if raw_session is None and (
        os.environ.get("CLAUDECODE")
        or os.environ.get("CLAUDE_CODE")
        or os.environ.get("CLAUDE_CODE_ENTRYPOINT")
    ):
        raw_session = "claude"

    # Always operate inside a named session. Without this fallback, pw would
    # target safari.windows[0].tabs[0] — i.e., whatever tab the user has
    # frontmost — which is exactly the tab-hijacking we must never do.
    if raw_session is None:
        raw_session = "default"

    if raw_session is not None:
        try:
            _session_name = _safe_session_name(raw_session)
        except PwError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(2)

    if not argv:
        print(__doc__)
        sys.exit(0)

    cmd = argv[0]
    args = argv[1:]

    if cmd not in COMMANDS:
        print(f"Unknown command: {cmd}\n", file=sys.stderr)
        print(__doc__)
        sys.exit(1)

    spec = COMMANDS[cmd]
    if len(args) < spec["min_args"]:
        print(f"Usage: {spec.get('usage', 'pw ' + cmd)}", file=sys.stderr)
        sys.exit(1)

    try:
        spec["handler"](args)
    except PwError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
