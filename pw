def _parse_batch_command(cmd_str):
    """Parse a batch command string into (command_name, args_list).

    Supports quoted arguments: 'fill #name "Jane Doe"'
    For eval, the JS expression is kept as a single string to preserve
    quotes and special characters: 'eval document.querySelectorAll("input")'
    Raises ValueError for empty, unknown, or under-specified commands.
    """
    import shlex
    cmd_str = cmd_str.strip()
    if not cmd_str:
        raise ValueError("Empty batch command")
    # Split off just the command name first
    first_space = cmd_str.find(" ")
    if first_space < 0:
        cmd = cmd_str
        args = []
    else:
        cmd = cmd_str[:first_space]
        rest = cmd_str[first_space + 1:].strip()
        # For eval and type, keep the rest as a single argument to preserve
        # JS syntax (quotes, parens, etc.)
        if cmd in ("eval", "type") and rest:
            args = [rest]
        elif rest:
            args = shlex.split(rest)
        else:
            args = []
    if cmd not in COMMANDS and cmd != "batch":
        raise PwError(f"Unknown command in batch: {cmd}")
    if cmd == "batch":
        raise PwError("Cannot nest batch commands")
    spec = COMMANDS[cmd]
    if len(args) < spec["min_args"]:
        raise PwError(
            f"Command '{cmd}' requires at least {spec['min_args']} arg(s), "
            f"got {len(args)}. {spec.get('usage', '')}"
        )
    return cmd, args


def _execute_batch_step(page, cmd, args):
    """Execute a single batch step against an existing page connection."""
    if cmd == "nav":
        clean, flag, flag_sel = _parse_output_flags(args)
        if not clean:
            raise PwError("nav requires a URL")
        url = clean[0]
        if not url.startswith(("http://", "https://", "file://")):
            url = "https://" + url
        page.goto(url, wait_until="domcontentloaded", timeout=30000)
        output = flag if flag is not None else "text"
        if output is False:
            output = None
        print(f"{page.title()}\n{page.url}")
        if output:
            _handle_output_flag(page, output, flag_sel)
    elif cmd == "click":
        clean, flag, flag_sel = _parse_output_flags(args)
        if not clean:
            raise PwError("click requires a SELECTOR")
        page.click(clean[0], timeout=5000)
        page.wait_for_load_state("domcontentloaded", timeout=5000)
        output = flag if flag is not None else None  # quiet by default in batch
        print(f"Clicked: {clean[0]}")
        if output:
            _handle_output_flag(page, output, flag_sel)
    elif cmd == "react-click":
        clean, flag, flag_sel = _parse_output_flags(args)
        if not clean:
            raise PwError("react-click requires a SELECTOR")
        method = page.react_click(clean[0], timeout=5000)
        output = flag if flag is not None else None
        print(f"React-clicked: {clean[0]} [{method}]")
        if output:
            _handle_output_flag(page, output, flag_sel)
    elif cmd == "react-set":
        if len(args) < 3:
