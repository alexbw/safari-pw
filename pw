def cmd_batch(command_strings):
    """Execute multiple commands in a single browser connection.

    This avoids the ~200ms Python startup overhead per command, making
    multi-step workflows significantly faster.
    """
    # Pre-parse all commands to fail fast on syntax errors
    parsed = []
    for i, cs in enumerate(command_strings, 1):
        try:
            cmd, args = _parse_batch_command(cs)
            parsed.append((i, cmd, args, cs))
        except (PwError, ValueError) as e:
            raise PwError(f"Batch step {i} ({cs!r}): {e}")

    def do(browser, ctx, page):
        for step_num, cmd, args, raw in parsed:
            try:
                print(f"[{step_num}/{len(parsed)}] {raw}")
                _execute_batch_step(page, cmd, args)
            except PwError as e:
                print(f"Error at step {step_num} ({raw!r}): {e}", file=sys.stderr)
                raise

    connect_and_run(do)


