    def bring_to_front(self):
        _jxa(f'''
        var safari = Application("Safari");
        safari.windows[{self._win}].currentTab = safari.windows[{self._win}].tabs[{self._idx}];
        "ok";
        ''')


class _SafariCtx:
    """Safari browser context — fetches tabs lazily via .pages."""

    def __init__(self, window_idx=0):
        self._win = window_idx

    @property
    def pages(self):
        raw = _jxa(f'''
        var safari = Application("Safari");
        var win = safari.windows[{self._win}];
        var tabs = [];
        for (var i = 0; i < win.tabs.length; i++) {{
            tabs.push({{title: win.tabs[i].name(), url: win.tabs[i].url()}});
        }}
        JSON.stringify(tabs);
        ''')
        tab_data = json.loads(raw) if raw else []
        return [_SafariTabProxy(i, t["title"], t["url"], window_idx=self._win) for i, t in enumerate(tab_data)]


class SafariPage:
    """Safari page interface via JXA/osascript."""

    def __init__(self, tab_idx=0, session_id=None, window_idx=0):
        self._tab = tab_idx
        self._win = window_idx
        self.keyboard = _SafariKeyboard(page=self)
        self._last_nav = {}  # cached title/url from goto()
        self._session_id = session_id or _new_session_id()

    def _find_tab_jxa(self):
        """Return JXA code that finds this session's tab by marker.

        Sets __pw_win (window ref) and __pw_tab (tab ref).
        Assumes `var safari = Application("Safari");` is already declared.
        """
        return _build_tab_finder_jxa(self._session_id, self._win, self._tab)

    def _do_js(self, js, timeout=30):
        """Execute JS in the current Safari tab via doJavaScript.

        Wraps the JS in a try/catch to detect errors that Safari's
        doJavaScript would otherwise silently swallow.
        """
        # Wrap JS to catch errors and return them as a detectable signal
        wrapped = f'''(function(){{
            try {{ return {js}; }}
            catch(e) {{ return "__PW_ERROR__:" + e.message; }}
        }})()'''
        escaped = json.dumps(wrapped)
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        safari.doJavaScript({escaped}, {{in: __pw_tab}});
        '''
        result = _jxa(script, timeout=timeout)
        if result and result.startswith("__PW_ERROR__:"):
            raise PwError(result[len("__PW_ERROR__:"):])
        return result

    def goto(self, url, wait_until=None, timeout=30000):
        escaped_url = _js_escape(url)
        timeout_s = max(timeout // 1000, 5)
        # Double-JSON: outer encodes the string for embedding in JXA
        # source; inner encodes the sid value for the JS we hand to
        # safari.doJavaScript at runtime, so the re-injected marker is a
        # valid JS string literal.
        sid_js_literal = json.dumps(json.dumps(self._session_id))
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var oldUrl = tab.url();
        tab.url = {escaped_url};
        var deadline = Date.now() + {timeout};
        var sameUrlNav = (oldUrl === {escaped_url} || oldUrl === {escaped_url} + "/" ||
                          oldUrl + "/" === {escaped_url});

        if (sameUrlNav) {{
            // Same-URL reload: just wait for readyState after a brief pause
            delay(0.3);
            while (Date.now() < deadline) {{
                try {{
                    var rs = safari.doJavaScript("document.readyState", {{in: tab}});
                    if (rs === "complete") break;
                }} catch(e) {{}}
                delay(0.1);
            }}
        }} else {{
            // Cross-URL nav: wait for JS context URL to change, then readyState
            while (Date.now() < deadline) {{
                try {{
                    var jsUrl = safari.doJavaScript("location.href", {{in: tab}});
                    if (jsUrl && jsUrl !== oldUrl) {{
                        var rs = safari.doJavaScript("document.readyState", {{in: tab}});
                        if (rs === "complete" || rs === "interactive") break;
                    }}
                }} catch(e) {{
                    // doJavaScript may throw during page transitions — that's fine
                }}
                delay(0.1);
            }}
        }}

        // Re-inject the session marker. The pre-nav data: URL had it
        // baked in, but the navigation just replaced the document. We
        // do this INSIDE the same script while we still hold `tab` —
        // running it via a separate _do_js would have to look up the
        // tab again by marker, and the marker is exactly what we're
        // trying to set (chicken-and-egg).
        try {{
            safari.doJavaScript(
                "window.__pw_session_id = " + {sid_js_literal} + "; " +
                "window.__pw_managed = true;",
                {{in: tab}}
            );
        }} catch(e) {{}}

        // Get title from JS context (tab.name() can be stale during navigation)
        var finalTitle = "";
        try {{ finalTitle = safari.doJavaScript("document.title", {{in: tab}}); }} catch(e) {{}}
        if (!finalTitle) finalTitle = tab.name();
        JSON.stringify({{title: finalTitle, url: tab.url()}});
        '''
        raw = _jxa(script, timeout=timeout_s + 5)
        # Cache result to avoid extra osascript calls
        try:
            self._last_nav = json.loads(raw) if raw else {}
        except (json.JSONDecodeError, TypeError):
            self._last_nav = {}
        # Persist tab state. Preserve any window_id recorded by the
        # resolver/creator so subsequent tab creations reuse pw's own
        # Safari window instead of spawning a fresh one.
        prior = _read_tab_state() or {}
        prior_wid = prior.get("window_id") if isinstance(prior, dict) else None
        _write_tab_state({
            "session_id": self._session_id,
            "url": self._last_nav.get("url", ""),
            "tab_index": self._tab,
            "window_index": self._win,
            "window_id": prior_wid,
        })

    def title(self):
        if self._last_nav:
            return self._last_nav.get("title", "")
        finder = self._find_tab_jxa()
        return _jxa(f'var safari = Application("Safari"); {finder} __pw_tab.name();') or ""

    @property
    def url(self):
        if self._last_nav:
            return self._last_nav.get("url", "")
        finder = self._find_tab_jxa()
        return _jxa(f'var safari = Application("Safari"); {finder} __pw_tab.url();') or ""


    def _auto_wait(self, sel_js, timeout=5000):
        """Poll for element existence up to timeout. Returns True if found.

        Polls at 1s intervals (not faster) to avoid overwhelming Safari's
        Apple Events handler, which can cause macOS to kill Safari for
        excessive CPU usage.
        """
        check_js = json.dumps(f'({sel_js}) !== null ? "found" : "nope"')
        finder = self._find_tab_jxa()
        # First check immediately
        try:
            result = _jxa(f'''
            var safari = Application("Safari");
            {finder}
            safari.doJavaScript({check_js}, {{in: __pw_tab}});
            ''', timeout=5)
            if result == "found":
                return True
        except PwError:
            pass
        # Then poll at 1s intervals — gentle on Safari's event handler
        deadline = time.time() + timeout / 1000
        while time.time() < deadline:
            time.sleep(1.0)
            try:
                result = _jxa(f'''
                var safari = Application("Safari");
                {finder}
                safari.doJavaScript({check_js}, {{in: __pw_tab}});
                ''', timeout=5)
                if result == "found":
                    return True
            except PwError:
                pass
        return False

    def _click_js(self, sel_js, selector):
        """Generate JS that clicks with React fiber support.

        Strategy (all background-safe via doJavaScript):
          A: el.click() -- native DOM method, works for many components.
          B: React 18 internal dispatch -- find the click listener registered on
             the React root container and invoke it via __dispatchEvent or by
             walking the fiber tree to find the actual app-level handler.
          C: React fiber onClick/onMouseDown prop invocation.
          D: Full synthetic pointer/mouse event sequence as last resort.
        """
        return (
            "(function(){"
            + REACT_FIBER_JS +

            # Utility: find app-level onClick by walking up past MUI wrapper components
            "function __pw_findAppHandler(fiber) {"
            "  var current = fiber;"
            "  var handlers = [];"
            "  while (current) {"
            "    if (current.memoizedProps && current.memoizedProps.onClick) {"
            "      handlers.push({handler: current.memoizedProps.onClick, type: current.type,"
            "        name: typeof current.type === 'function' ? current.type.name || current.type.displayName : String(current.type)});"
            "    }"
            "    current = current.return;"
            "  }"
            # Return the highest-level handler (closest to app root, furthest from DOM)
            # Skip the first one if it's on 'button' (MUI ButtonBase ripple handler)
            "  if (handlers.length > 1 && handlers[0].name === 'button') return handlers[handlers.length - 1];"
            "  return handlers.length > 0 ? handlers[handlers.length - 1] : null;"
            "}"

            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + _js_escape(selector) + ");"
            "el.scrollIntoView({block: 'center'});"

            # Strategy A: el.click()
            "try { el.click(); } catch(e) {}"

            # Strategy B: Find app-level handler via fiber tree (skip MUI wrappers)
            "var fiber = __pw_getReactFiber(el);"
            "if (fiber) {"
            "  var appHandler = __pw_findAppHandler(fiber);"
            "  if (appHandler && appHandler.handler) {"
            "    try {"
            "      appHandler.handler(__pw_makeSyntheticEvent(el, 'click'));"
            "      return 'clicked (react app handler: ' + appHandler.name + ')';"
            "    } catch(e) {}"
            "  }"

            # Strategy C: Direct fiber prop handlers (onMouseDown + onClick)
            "  var onMD = __pw_findHandler(fiber, 'onMouseDown');"
            "  if (onMD) { try { onMD(__pw_makeSyntheticEvent(el, 'mousedown')); } catch(e) {} }"
            "  var onClick = __pw_findHandler(fiber, 'onClick');"
            "  if (onClick) {"
            "    try { onClick(__pw_makeSyntheticEvent(el, 'click')); } catch(e) {}"
            "    return 'clicked (react fiber onClick)';"
            "  }"
            "}"

            # Strategy D: Synthetic event sequence
            "var rect = el.getBoundingClientRect();"
            "var x = rect.left + rect.width / 2;"
            "var y = rect.top + rect.height / 2;"
            "var opts = {bubbles: true, cancelable: true, view: window,"
            "  clientX: x, clientY: y, screenX: x, screenY: y,"
            "  button: 0, buttons: 1};"
            "el.dispatchEvent(new PointerEvent('pointerdown', opts));"
            "el.dispatchEvent(new MouseEvent('mousedown', opts));"
            "el.dispatchEvent(new PointerEvent('pointerup', opts));"
            "el.dispatchEvent(new MouseEvent('mouseup', opts));"
            "el.dispatchEvent(new MouseEvent('click', opts));"
            "return 'clicked (el.click + synthetic events)';"
            "})()"
        )


    def click(self, selector, timeout=5000):
        sel_js = _translate_selector(selector)
        # Auto-wait for element to appear
        if not self._auto_wait(sel_js, timeout):
            raise PwError(f"Element not found (timeout {timeout}ms): {selector}")
        # Batch: click + wait for potential navigation + title/url in one JXA call
        js_code = json.dumps(self._click_js(sel_js, selector))
        script = f'''
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var urlBefore = tab.url();
        safari.doJavaScript({js_code}, {{in: tab}});
        // Wait for potential navigation (URL change or page load)
        var deadline = Date.now() + {timeout};
        delay(0.05);
        while (Date.now() < deadline) {{
            try {{
                var u = tab.url();
                if (u !== urlBefore) {{
                    // URL changed — wait for title to settle
                    delay(0.2);
                    try {{ safari.doJavaScript("document.readyState", {{in: tab}}); }} catch(e2) {{}}
                    break;
                }}
                // URL same — page didn't navigate, we're done
                break;
            }} catch(e) {{
                delay(0.2);
            }}
        }}
        JSON.stringify({{title: tab.name(), url: tab.url()}});
        '''
        self._last_nav = {}
        try:
            raw = _jxa(script, timeout=timeout // 1000 + 5)
            self._last_nav = json.loads(raw) if raw else {}
        except PwError as e:
            err = str(e)
            if "Element not found" in err:
                raise
            # JXA timeout after click is non-fatal (click succeeded, page may be loading)
            if "timed out" in err.lower():
                self._last_nav = {}
            else:
                raise

    def _react_click_js(self, sel_js, selector):
        """JS that clicks exclusively via React fiber handlers."""
        return (
            "(function(){"
            + REACT_FIBER_JS +
            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + _js_escape(selector) + ");"
            "el.scrollIntoView({block: 'center'});"
            "var fiber = __pw_getReactFiber(el);"
            "if (!fiber) { el.click(); return 'clicked (no fiber, used el.click)'; }"
            "var onMD = __pw_findHandler(fiber, 'onMouseDown');"
            "if (onMD) { try { onMD(__pw_makeSyntheticEvent(el, 'mousedown')); } catch(e) {} }"
            "var onClick = __pw_findHandler(fiber, 'onClick');"
            "if (onClick) { onClick(__pw_makeSyntheticEvent(el, 'click')); return 'clicked (react fiber onClick)'; }"
            "var onPress = __pw_findHandler(fiber, 'onPress');"
            "if (onPress) { onPress(__pw_makeSyntheticEvent(el, 'click')); return 'clicked (react fiber onPress)'; }"
            "el.click();"
            "return 'clicked (fiber found, no handler, used el.click)';"
            "})()"
        )

    def _react_set_js(self, sel_js, selector, prop, value):
        """JS that sets a React component prop by invoking its handler."""
        escaped_prop = _js_escape(prop)
        escaped_value = _js_escape(value)
        return (
            "(function(){"
            + REACT_FIBER_JS +
            "var el = " + sel_js + ";"
            "if (!el) throw new Error('Element not found: ' + " + _js_escape(selector) + ");"
            "var fiber = __pw_getReactFiber(el);"
            "if (!fiber) throw new Error('No React fiber on: ' + " + _js_escape(selector) + ");"
            "var propName = " + escaped_prop + ";"
            "var handler = __pw_findHandler(fiber, propName);"
            "if (!handler) throw new Error('No ' + propName + ' handler in fiber tree for: ' + " + _js_escape(selector) + ");"
            "var rawValue = " + escaped_value + ";"
            "var parsedValue; try { parsedValue = JSON.parse(rawValue); } catch(e) { parsedValue = rawValue; }"
            "if (propName === 'onChange') {"
            "  handler({target: {value: parsedValue}, currentTarget: {value: parsedValue},"
            "    preventDefault: function(){}, stopPropagation: function(){}});"
            "} else { handler(parsedValue); }"
            "return 'set ' + propName + ' via React fiber';"
            "})()"
        )

    def react_click(self, selector, timeout=5000):
        """Click via React fiber handlers (background-safe)."""
        sel_js = _translate_selector(selector)
        # Auto-wait for element
        if not self._auto_wait(sel_js, timeout):
            raise PwError(f"Element not found (timeout {timeout}ms): {selector}")
        js_code = json.dumps(self._react_click_js(sel_js, selector))
        script = f"""
        var safari = Application("Safari");
        {self._find_tab_jxa()}
        var tab = __pw_tab;
        var urlBefore = tab.url();
        var result = safari.doJavaScript({js_code}, {{in: tab}});
        var deadline = Date.now() + {timeout};
        delay(0.05);
        while (Date.now() < deadline) {{
            try {{
                var u = tab.url();
                if (u !== urlBefore) {{
                    delay(0.2);
                    try {{ safari.doJavaScript("document.readyState", {{in: tab}}); }} catch(e2) {{}}
                    break;
